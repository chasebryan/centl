#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

bash -n scripts/caravan-public-origin-install
bash -n scripts/caravan-public-origin-ingest
bash -n scripts/caravan-public-origin-audit
bash -n scripts/caravan-public-origin-activate-gate
python3 -m py_compile \
  scripts/caravan-public-origin-candidate.py \
  scripts/caravan-public-origin-activate.py \
  scripts/caravan-public-origin-source-guard.py \
  tests/test_caravan_public_origin.py

out=$(mktemp)
trap 'rm -f "$out"' EXIT HUP INT TERM
if ! python3 -m unittest discover -s tests -p 'test_caravan_public_origin.py' >"$out" 2>&1; then
  cat "$out" >&2
  message=$(tail -n 30 "$out" | tr '\n\r' '  ' | sed 's/%/%25/g; s/:/%3A/g')
  printf '::error title=CARAVAN public-origin adversarial gate::%s\n' "$message"
  exit 1
fi
cat "$out"
rm -f "$out"
trap - EXIT HUP INT TERM

printf 'CENTL CARAVAN public-origin gate: PASS\n'
