#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

for script in \
  scripts/caravan-linux-platform \
  scripts/caravan-public-origin-install \
  scripts/caravan-public-origin-ingest \
  scripts/caravan-public-origin-authorize-source \
  scripts/caravan-public-origin-firewall \
  scripts/caravan-public-origin-audit \
  scripts/caravan-public-origin-activate-gate \
  scripts/caravan-join-template \
  scripts/caravan-join-release \
  scripts/caravan-join-verify; do
  bash -n "$script"
done

python3 -m py_compile \
  scripts/caravan-public-origin-candidate.py \
  scripts/caravan-public-origin-source-export.py \
  scripts/caravan-public-origin-activate.py \
  scripts/caravan-public-origin-source-guard.py \
  tests/test_caravan_public_origin.py \
  tests/test_caravan_join_release.py

out=$(mktemp)
trap 'rm -f "$out"' EXIT HUP INT TERM
if ! python3 -m unittest discover -s tests -p 'test_caravan_*.py' >"$out" 2>&1; then
  cat "$out" >&2
  message=$(tail -n 50 "$out" | tr '\n\r' '  ' | sed 's/%/%25/g; s/:/%3A/g')
  printf '::error title=CARAVAN public-origin/join adversarial gate::%s\n' "$message"
  exit 1
fi
cat "$out"
rm -f "$out"
trap - EXIT HUP INT TERM

printf 'CENTL CARAVAN public-origin and join-release gate: PASS\n'
