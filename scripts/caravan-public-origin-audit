#!/bin/bash
set -Eeuo pipefail

fail() {
  printf 'fcf caravan public-origin audit: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required"
}

need curl
need nginx
need systemctl
need getent
need python3
need ufw

ENV_FILE=${FCF_CARAVAN_ENV_FILE:-/etc/fcf-caravan/public-origin.env}
[ -r "$ENV_FILE" ] || fail "environment file is missing"
# shellcheck disable=SC1090
set -a
. "$ENV_FILE"
set +a

DOMAIN=${FCF_CARAVAN_DOMAIN:-}
LIVE_ROOT=${FCF_CARAVAN_LIVE_ROOT:-/srv/fcf-caravan-live}
[ -n "$DOMAIN" ] || fail "FCF_CARAVAN_DOMAIN is missing"
case "$DOMAIN" in *[!A-Za-z0-9.-]*|'') fail "unsafe domain" ;; esac

nginx -t >/dev/null 2>&1 || fail "nginx configuration test failed"
systemctl is-active --quiet nginx || fail "nginx is not active"
for timer in fcf-caravan-ingest.timer fcf-caravan-candidate.timer fcf-caravan-activate.timer; do
  systemctl is-enabled --quiet "$timer" || fail "$timer is not enabled"
done

current="$LIVE_ROOT/current"
[ -L "$current" ] || fail "live current pointer is missing"
target=$(readlink "$current")
case "$target" in generations/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z-[0-9]*) ;;
  *) fail "live pointer has unsafe target: $target" ;;
esac
[ -d "$LIVE_ROOT/$target" ] || fail "live generation target is missing"
[ ! -L "$LIVE_ROOT/$target" ] || fail "live generation itself is a symlink"

site=/etc/nginx/sites-enabled/fcf-caravan
[ -f "$site" ] && [ ! -L "$site" ] || fail "installed nginx site must be a regular file"
if grep -Eiq '(^|[[:space:]])(proxy_pass|fastcgi_pass|uwsgi_pass|scgi_pass|dav_methods|auth_request)[[:space:]]' "$site"; then
  fail "dynamic/proxy/upload-capable nginx directive found"
fi
grep -Fq 'if ($request_method !~ ^(GET|HEAD)$)' "$site" || fail "GET/HEAD-only method gate missing"
grep -Fq 'location / {' "$site" || fail "default-deny location missing"
grep -Fq 'access_log off;' "$site" || fail "access-log minimization missing"
grep -Fq 'max_ranges 1;' "$site" || fail "range-abuse bound missing"

unrelated=$(find /etc/nginx/sites-enabled -mindepth 1 -maxdepth 1 ! -name fcf-caravan -print -quit 2>/dev/null || true)
[ -z "$unrelated" ] || fail "unrelated nginx site is enabled: $unrelated"

user_shell=$(getent passwd fcf-caravan | awk -F: '{print $7}')
case "$user_shell" in */nologin|*/false) ;; *) fail "fcf-caravan service account has an interactive shell" ;; esac

base="https://$DOMAIN"
resolve=(--resolve "$DOMAIN:443:127.0.0.1")
code() {
  curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --connect-timeout 5 --max-time 30 "${resolve[@]}" "$@"
}

[ "$(code "$base/")" = 200 ] || fail "home page is not HTTP 200"
[ "$(code "$base/status.json")" = 200 ] || fail "status endpoint is not HTTP 200"
[ "$(code --head "$base/source/centl-oasis.tar.gz")" = 200 ] || fail "Oasis source snapshot is not HTTP 200"

for method in POST PUT PATCH DELETE CONNECT TRACE OPTIONS; do
  result=$(code -X "$method" "$base/source/centl-main.tar.gz")
  case "$result" in 2??|3??) fail "$method unexpectedly succeeded with HTTP $result" ;; esac
done

for path in \
  '/.git/config' \
  '/source/.git/config' \
  '/source/' \
  '/releases/' \
  '/semantic/' \
  '/etc/passwd' \
  '/%2e%2e/%2e%2e/etc/passwd' \
  '/source/%2e%2e/%2e%2e/etc/passwd' \
  '/this-does-not-exist'; do
  result=$(code "$base$path")
  case "$result" in 2??) fail "forbidden probe $path returned HTTP $result" ;; esac
done

status_tmp=$(mktemp)
trap 'rm -f "$status_tmp"' EXIT HUP INT TERM
curl --silent --show-error --fail --connect-timeout 5 --max-time 30 \
  "${resolve[@]}" "$base/status.json" > "$status_tmp"
python3 - "$status_tmp" <<'PY'
import json
from pathlib import Path
import sys
try:
    data = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"status is not valid JSON: {exc}")
if data.get("schema") != "fcf-caravan-public-origin-status-v1":
    raise SystemExit("status schema mismatch")
for key in ("uploads", "proxying", "arbitrary_paths"):
    if data.get(key) is not False:
        raise SystemExit(f"forbidden capability enabled: {key}")
PY
rm -f "$status_tmp"
trap - EXIT HUP INT TERM

ufw status | grep -Fq 'Status: active' || fail "ufw is not active"
ufw status verbose | grep -Fq 'Default: deny (incoming)' || fail "ufw incoming policy is not default-deny"

printf 'fcf caravan public-origin audit: PASS\n'
printf 'domain=%s\n' "$DOMAIN"
printf 'live_generation=%s\n' "${target#generations/}"
