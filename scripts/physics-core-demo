#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$project_root"

physics_binary="_build/default/src/physics_main.exe"
if [ ! -x "$physics_binary" ]; then
  echo "CENTL Physics is not built. Run: opam exec --switch=centl -- make build" >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "This presentation script requires jq." >&2
  exit 1
fi

printf '\033[2J\033[H'
printf '\033[1;36mCENTL PHYSICS CORE — EXACT-RATIONAL PARTICLE MECHANICS\033[0m\n\n'

printf '\033[1mDIMENSION-SAFE UNITS\033[0m\n'
printf 'Input: 150 cm -> m\n'
printf 'Result: '
"$physics_binary" convert 150 cm m

if dimension_error=$("$physics_binary" convert 1 m s 2>&1); then
  printf 'Unexpectedly accepted incompatible dimensions: %s\n' "$dimension_error"
else
  printf 'Rejected: %s\n' "$dimension_error"
fi

printf '\n\033[1mEXACT GRAVITY TRAJECTORY\033[0m\n'
printf 'Initial: m=2 kg | position=(0,0,10) m | velocity=(1,0,0) m/s\n'
printf 'Force:   uniform gravity=(0,0,-10) m/s^2 | dt=1/10 s | steps=10\n\n'
"$physics_binary" gravity 2 0,0,10 1,0,0 0,0,-10 1/10 10 |
  sed 's/^/  /'

printf '\n\033[1mEXACT PHYSICAL CONSTANT\033[0m\n'
"$physics_binary" constant c |
  sed 's/^/  /'

printf '\n\033[1mELASTIC COLLISION INVARIANTS\033[0m\n'
printf 'Initial: m1=2 kg, v1=3 m/s | m2=1 kg, v2=-1 m/s\n\n'

collision_request='{"version":1,"id":"physics-core-demo","action":"elastic_collision_1d","mass1":{"value":"2","unit":"kg"},"velocity1":{"value":"3","unit":"m/s"},"mass2":{"value":"1","unit":"kg"},"velocity2":{"value":"-1","unit":"m/s"}}'

printf '%s\n' "$collision_request" |
  "$physics_binary" --serve |
  jq -r '
    .physics as $p |
    "  Final:    v1=\($p.velocity1_final.text) | v2=\($p.velocity2_final.text)",
    "  Momentum: \($p.invariants.initial_momentum.text) -> \($p.invariants.final_momentum.text)  CONSERVED=\($p.invariants.momentum)",
    "  Energy:   \($p.invariants.initial_kinetic_energy.text) -> \($p.invariants.final_kinetic_energy.text)  CONSERVED=\($p.invariants.kinetic_energy)",
    "  Exact:    \($p.exact)"'
