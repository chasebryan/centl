#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
command=${1:-}
primary=${2:-}
secondary=${3:-}
manifest_name=MIRROR-SHA256SUMS
manifest_hash_name=MIRROR-SHA256SUMS.sha256

fail() {
  printf 'centl mirror-receipt: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  sh scripts/mirror-receipt create MIRROR_DIR
  sh scripts/mirror-receipt verify MIRROR_DIR
  sh scripts/mirror-receipt compare PRIMARY_MIRROR SECONDARY_COPY

The receipt covers every regular file in the mirror except the receipt files
MIRROR-SHA256SUMS and MIRROR-SHA256SUMS.sha256 themselves. Symlinks and unexpected
extra files are rejected during strict verification.
EOF
}

need_dir() {
  [ -n "$1" ] || fail "mirror directory is required"
  [ -d "$1" ] || fail "mirror directory not found: $1"
}

canonical_dir() {
  CDPATH= cd -- "$1" && pwd
}

verify_one() {
  root=$1
  manifest="$root/$manifest_name"
  manifest_hash="$root/$manifest_hash_name"
  [ -f "$manifest" ] || fail "mirror receipt missing: $manifest"
  [ -f "$manifest_hash" ] || fail "mirror receipt checksum missing: $manifest_hash"

  python3 "$repo_root/scripts/integrity.py" verify "$manifest_hash" --root "$root"
  python3 "$repo_root/scripts/integrity.py" tree-verify "$manifest" \
    --root "$root" \
    --ignore "$manifest_name" \
    --ignore "$manifest_hash_name"
}

case "$command" in
  create)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    need_dir "$primary"
    primary=$(canonical_dir "$primary")
    manifest="$primary/$manifest_name"
    manifest_hash="$primary/$manifest_hash_name"

    rm -f "$manifest" "$manifest_hash"
    python3 "$repo_root/scripts/integrity.py" tree-manifest \
      --root "$primary" --output "$manifest"
    python3 "$repo_root/scripts/integrity.py" hash "$manifest" > "$manifest_hash"
    verify_one "$primary"
    printf 'FCF mirror receipt created and verified: %s\n' "$manifest"
    ;;
  verify)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    need_dir "$primary"
    primary=$(canonical_dir "$primary")
    verify_one "$primary"
    printf 'FCF mirror receipt verification: PASS (%s)\n' "$primary"
    ;;
  compare)
    [ "$#" -eq 3 ] || { usage >&2; exit 2; }
    need_dir "$primary"
    need_dir "$secondary"
    primary=$(canonical_dir "$primary")
    secondary=$(canonical_dir "$secondary")

    verify_one "$primary"
    [ -f "$secondary/$manifest_name" ] ||
      fail "secondary copy is missing $manifest_name"
    [ -f "$secondary/$manifest_hash_name" ] ||
      fail "secondary copy is missing $manifest_hash_name"
    cmp -s "$primary/$manifest_name" "$secondary/$manifest_name" ||
      fail "secondary checksum manifest differs from primary"
    cmp -s "$primary/$manifest_hash_name" "$secondary/$manifest_hash_name" ||
      fail "secondary manifest checksum differs from primary"

    python3 "$repo_root/scripts/integrity.py" verify \
      "$secondary/$manifest_hash_name" --root "$secondary"
    python3 "$repo_root/scripts/integrity.py" tree-verify \
      "$primary/$manifest_name" \
      --root "$secondary" \
      --ignore "$manifest_name" \
      --ignore "$manifest_hash_name"

    printf 'FCF mirror copy verification: PASS\n'
    printf 'primary=%s\n' "$primary"
    printf 'secondary=%s\n' "$secondary"
    ;;
  -h|--help|help|'')
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
