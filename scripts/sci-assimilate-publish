#!/usr/bin/env sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

branch=$(git branch --show-current)
if [ -z "$branch" ]; then
  echo "CENTL-SCi: assimilation publishing requires a named Git branch" >&2
  exit 2
fi
if [ "$branch" = "main" ] && [ "${CENTL_SCI_ALLOW_MAIN_REPORT:-0}" != "1" ]; then
  echo "CENTL-SCi: refusing to publish an assimilation report directly to main" >&2
  echo "set CENTL_SCI_ALLOW_MAIN_REPORT=1 only if that is intentional" >&2
  exit 2
fi

source_head=$(git rev-parse HEAD)
json_report="lab/sci-assimilation/latest.json"
markdown_report="lab/sci-assimilation/latest.md"
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM
tmp_json="$tmpdir/latest.json"
tmp_markdown="$tmpdir/latest.md"

set +e
python3 scripts/sci-assimilate.py \
  --output-json "$tmp_json" \
  --output-markdown "$tmp_markdown" \
  "$@"
harness_status=$?
set -e

if [ ! -f "$tmp_json" ] || [ ! -f "$tmp_markdown" ]; then
  echo "CENTL-SCi: assimilation harness did not produce fresh report files" >&2
  exit 1
fi

python3 scripts/sci-assimilation-check.py "$tmp_json"
reported_head=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["git"]["commit"])' "$tmp_json")
if [ "$reported_head" != "$source_head" ]; then
  echo "CENTL-SCi: report source commit does not match the tested HEAD" >&2
  exit 1
fi

mkdir -p "$(dirname "$json_report")"
cp "$tmp_json" "$json_report"
cp "$tmp_markdown" "$markdown_report"

git add -- "$json_report" "$markdown_report"
if git diff --cached --quiet -- "$json_report" "$markdown_report"; then
  echo "CENTL-SCi: assimilation report unchanged; nothing to publish"
else
  short_commit=$(printf '%s' "$source_head" | cut -c1-8)
  git commit --only -m "Record CENTL-SCi assimilation report for $short_commit" -- \
    "$json_report" "$markdown_report"
  git push origin "HEAD:$branch"
  echo "CENTL-SCi: published assimilation report on $branch"
fi

exit "$harness_status"
