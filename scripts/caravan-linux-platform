#!/bin/bash
# Shared Linux platform adapter for CARAVAN installers.
# Source this file from bash; it intentionally performs no work on load.

fcf_linux_fail() {
  printf 'fcf caravan linux platform: %s\n' "$*" >&2
  return 1
}

fcf_linux_require_kernel() {
  [ "$(uname -s 2>/dev/null || true)" = Linux ] || fcf_linux_fail "Linux is required"
}

fcf_linux_require_systemd() {
  command -v systemctl >/dev/null 2>&1 || fcf_linux_fail "systemd is required for the FCF public-origin role"
  [ -d /run/systemd/system ] || fcf_linux_fail "systemd is not the active service manager"
}

fcf_linux_package_manager() {
  for manager in apt-get dnf yum zypper pacman; do
    if command -v "$manager" >/dev/null 2>&1; then
      printf '%s\n' "$manager"
      return 0
    fi
  done
  return 1
}

fcf_linux_install_origin_dependencies() {
  # If everything is already present, unusual distributions can still use the
  # installer without a recognized package manager.
  local missing=0
  local cmd
  for cmd in certbot curl find git gzip nft nginx python3 ss systemctl; do
    command -v "$cmd" >/dev/null 2>&1 || missing=1
  done
  [ "$missing" -eq 0 ] && return 0

  local manager
  manager=$(fcf_linux_package_manager) || {
    fcf_linux_fail "missing dependencies and no supported package manager found (apt, dnf, yum, zypper, pacman)"
    return 1
  }

  case "$manager" in
    apt-get)
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y --no-install-recommends \
        ca-certificates certbot coreutils curl findutils git gzip iproute2 nginx \
        nftables python3 util-linux
      ;;
    dnf)
      dnf install -y \
        ca-certificates certbot coreutils curl findutils git gzip iproute nginx \
        nftables python3 util-linux
      ;;
    yum)
      yum install -y \
        ca-certificates certbot coreutils curl findutils git gzip iproute nginx \
        nftables python3 util-linux
      ;;
    zypper)
      zypper --non-interactive refresh
      zypper --non-interactive install \
        ca-certificates certbot coreutils curl findutils git gzip iproute2 nginx \
        nftables python3 util-linux
      ;;
    pacman)
      pacman -Sy --needed --noconfirm \
        ca-certificates certbot coreutils curl findutils git gzip iproute2 nginx \
        nftables python util-linux
      ;;
    *)
      fcf_linux_fail "unsupported package manager: $manager"
      return 1
      ;;
  esac

  for cmd in certbot curl find git gzip nft nginx python3 ss systemctl; do
    command -v "$cmd" >/dev/null 2>&1 || {
      fcf_linux_fail "dependency installation did not provide $cmd"
      return 1
    }
  done
}

fcf_linux_nginx_site_dir() {
  # Normalize distro nginx packaging into the Debian-style directory used by the
  # security audit. The installer creates this include if the distro lacks it.
  printf '%s\n' /etc/nginx/sites-enabled
}
