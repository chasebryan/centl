#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path

from telepathy.carrier import CarrierStatus
from telepathy.tor import TorOnionCarrier, TorOnionConfig


def _status_json(status: CarrierStatus) -> str:
    return json.dumps(
        {
            "carrier": status.carrier,
            "available": status.available,
            "published": status.published,
            "endpoint": status.endpoint,
            "pid": status.pid,
            "detail": status.detail,
        },
        sort_keys=True,
    )


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="telepathyctl")
    subcommands = parser.add_subparsers(dest="domain", required=True)
    carrier = subcommands.add_parser("carrier", help="control a replaceable Telepathy carrier")
    carrier.add_argument("action", choices=("probe", "publish", "status", "withdraw"))
    carrier.add_argument("--carrier", choices=("tor-onion",), default="tor-onion")
    carrier.add_argument("--telepathy-host", default="127.0.0.1")
    carrier.add_argument("--telepathy-port", type=int, default=8790)
    carrier.add_argument("--virtual-port", type=int, default=80)
    carrier.add_argument("--state-dir", type=Path, default=Path(".telepathy"))
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    if args.domain != "carrier":
        raise SystemExit("unsupported Telepathy control domain")

    implementation = TorOnionCarrier(
        TorOnionConfig(
            telepathy_host=args.telepathy_host,
            telepathy_port=args.telepathy_port,
            virtual_port=args.virtual_port,
            state_dir=args.state_dir / "tor",
        )
    )
    action = getattr(implementation, args.action)
    status = action()
    print(_status_json(status))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
