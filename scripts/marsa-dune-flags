#!/bin/sh
# Emit Dune sexp flag lists for the current FLINT/GMP/MPFR prefix.
# Usage: marsa-dune-flags cflags|libs
set -eu

mode=${1:-cflags}

tokens() {
  printf '('
  for tok in "$@"; do
    tok=$(printf '%s' "$tok" | tr -d '\r')
    [ -n "$tok" ] || continue
    case "$tok" in
      *[:\\]*) printf ' "%s"' "$tok" ;;
      *) printf ' %s' "$tok" ;;
    esac
  done
  printf ' )\n'
}

cflags=""
libs="-lflint -lmpfr -lgmp -lpthread -lm"

# MSYS2 pkg-config prints /ucrt64 or /mingw64. ocamlopt needs a real drive path.
rewrite_msys_roots() {
  text=$1
  root=${MSYS2_ROOT:-}
  if [ -z "$root" ] && [ -d /ucrt64 ]; then
    root=$(cd /ucrt64/.. && pwd)
  fi
  if [ -z "$root" ]; then
    printf '%s' "$text"
    return
  fi
  root=$(printf '%s' "$root" | tr '\\' '/')
  printf '%s' "$text" | sed "s|/ucrt64|${root}/ucrt64|g; s|/mingw64|${root}/mingw64|g"
}

if command -v brew >/dev/null 2>&1; then
  prefix=$(brew --prefix 2>/dev/null || true)
  if [ -n "$prefix" ]; then
    PKG_CONFIG_PATH="$prefix/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
    export PKG_CONFIG_PATH
  fi
fi

if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists flint; then
  cflags=$(pkg-config --cflags flint gmp mpfr 2>/dev/null || pkg-config --cflags flint)
  libs=$(pkg-config --libs flint gmp mpfr 2>/dev/null || pkg-config --libs flint)
  cflags=$(printf '%s' "$cflags" | tr -d '\r' | tr '\n' ' ')
  libs=$(printf '%s' "$libs" | tr -d '\r' | tr '\n' ' ')
  cflags=$(rewrite_msys_roots "$cflags")
  libs=$(rewrite_msys_roots "$libs")
  case $(uname -s) in
    Darwin|Linux)
      case " $libs " in
        *" -lpthread "*) ;;
        *) libs="$libs -lpthread" ;;
      esac
      case " $libs " in
        *" -lm "*) ;;
        *) libs="$libs -lm" ;;
      esac
      ;;
  esac
fi

case "$mode" in
  cflags)
    # shellcheck disable=SC2086
    tokens $cflags
    ;;
  libs)
    # shellcheck disable=SC2086
    tokens $libs
    ;;
  *)
    printf 'usage: %s cflags|libs\n' "$(basename "$0")" >&2
    exit 2
    ;;
esac
