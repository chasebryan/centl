#!/bin/bash
set -Eeuo pipefail

umask 077

fail() {
  printf 'FCF CARAVAN join-key ceremony: %s\n' "$*" >&2
  exit 1
}
need() { command -v "$1" >/dev/null 2>&1 || fail "$1 is required"; }

OUTPUT_DIR=""
KEY_NAME="fcf-caravan-join-2026"

usage() {
  cat <<'TXT'
Usage:
  scripts/caravan-join-key-ceremony --output-dir /protected/fcf-keys \
    [--key-name fcf-caravan-join-2026]

Generate the dedicated passphrase-protected FCF CARAVAN join signing identity.
Run this only on a trusted FCF administrator system. The output directory must
be outside the CENTL repository and should not be synchronized to ordinary cloud
storage or hosted CI.
TXT
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --output-dir) [ "$#" -ge 2 ] || fail "--output-dir needs a value"; OUTPUT_DIR=$2; shift 2 ;;
    --key-name) [ "$#" -ge 2 ] || fail "--key-name needs a value"; KEY_NAME=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown option: $1" ;;
  esac
done

[ -n "$OUTPUT_DIR" ] || fail "--output-dir is required"
printf '%s' "$KEY_NAME" | grep -Eq '^[A-Za-z0-9._-]+$' || fail "unsafe key name"
for cmd in git signify sha256sum mktemp; do need "$cmd"; done

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
out=$(readlink -m -- "$OUTPUT_DIR")
case "$out" in
  "$repo_root"|"$repo_root"/*) fail "signing keys must never be created inside the CENTL repository" ;;
esac

if [ -e "$out" ] || [ -L "$out" ]; then
  [ -d "$out" ] && [ ! -L "$out" ] || fail "output directory must be a real directory"
else
  mkdir -p -- "$out"
fi
chmod 0700 -- "$out"

secret="$out/$KEY_NAME.sec"
public="$out/$KEY_NAME.pub"
[ ! -e "$secret" ] && [ ! -L "$secret" ] || fail "secret key path already exists"
[ ! -e "$public" ] && [ ! -L "$public" ] || fail "public key path already exists"

printf '\nFCF CARAVAN JOIN SIGNING KEY CEREMONY\n'
printf 'Output directory: %s\n' "$out"
printf 'Key name:         %s\n\n' "$KEY_NAME"
printf 'signify will now ask for a passphrase. Do not use an empty passphrase.\n'
printf 'Do not use signify -n for this production key.\n\n'

signify -G -p "$public" -s "$secret"
chmod 0600 -- "$secret"
chmod 0644 -- "$public"

challenge=$(mktemp "$out/.caravan-key-check.XXXXXX")
signature="$challenge.sig"
trap 'rm -f -- "$challenge" "$signature"' EXIT HUP INT TERM
printf 'FCF CARAVAN join-key verification challenge\n' > "$challenge"
signify -S -s "$secret" -m "$challenge" -x "$signature"
signify -V -q -p "$public" -m "$challenge" -x "$signature"

fingerprint=$(sha256sum "$public" | awk '{print $1}')

cat <<TXT

FCF CARAVAN join-key ceremony: PASS
public_key=$public
public_key_sha256=$fingerprint
secret_key=$secret

NEXT REQUIRED ACTIONS
1. Back up the secret key through an FCF-approved offline recovery method.
2. Cross-publish ONLY the public key through multiple FCF-controlled channels.
3. Record the public-key SHA-256 exactly as printed above.
4. Keep the secret key out of Git, GitHub Actions, ordinary cloud sync, carriers,
   web roots, and the public-origin host unless a separate security decision says otherwise.
5. Use these paths only during an explicit `scripts/caravan-join-release` ceremony.

The key exists, but public enrollment is NOT enabled by this command.
TXT
