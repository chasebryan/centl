#!/bin/sh
set -eu

# Oasis native releases are deliberately GNU/Linux x86_64 only. Historical
# multi-platform packaging logic is retained behind this wrapper for source
# archaeology, but the authoritative stable-product entry point refuses to
# activate it on unsupported hosts.
case $(uname -s) in
  Linux) ;;
  *)
    printf 'centl package: Oasis native releases support GNU/Linux x86_64 only\n' >&2
    exit 1
    ;;
esac
case $(uname -m) in
  x86_64|amd64) ;;
  *)
    printf 'centl package: Oasis native releases support GNU/Linux x86_64 only: %s\n' "$(uname -m)" >&2
    exit 1
    ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
output_directory=${2:-"$project_root/dist"}

"$script_dir/package-release-legacy" "$@"
python3 "$script_dir/check-linux-release-abi.py" \
  "$output_directory/centl-linux-x86_64.tar.gz"
