#!/bin/sh
set -eu

# Native CENTL releases are intentionally GNU/Linux x86_64 only.
# Pinned CI defaults (also checked against toolchain.lock):
# FLINT 3.0.1; sha256 7b311a00503a863881eb8177dbeb84322f29399f3d7d72f3b1a4c9ba1d5794b4
# GMP 6.3.0; sha256 a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898
# MPFR 4.2.2; sha256 b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
version=${1:-}
output_directory=${2:-"$project_root/dist"}
binary=${CENTL_BINARY:-"$project_root/_build/default/src/main.exe"}
physics_binary=${CENTL_PHYSICS_BINARY:-"$project_root/_build/default/src/physics_main.exe"}
sci_binary=${CENTL_SCI_BINARY:-"$project_root/_build/default/src/sci_main.exe"}
mirage_binary=${CENTL_MIRAGE_BINARY:-"$project_root/_build/default/src/mirage_main.exe"}
tar_command=${TAR:-tar}

fail() {
  printf 'centl package: %s\n' "$1" >&2
  exit 1
}

[ -n "$version" ] || fail "usage: scripts/package-release VERSION [OUTPUT_DIR]"
version=${version#v}
case "$version" in
  ''|*/*|*..*|*[!0-9A-Za-z.+_-]*) fail "invalid version: $version" ;;
esac

case $(uname -s) in
  Linux) ;;
  Darwin) fail "macOS release packaging is unsupported; CENTL native releases are GNU/Linux only" ;;
  *) fail "CENTL native release packaging supports GNU/Linux only" ;;
esac

case $(uname -m) in
  x86_64|amd64) architecture=x86_64 ;;
  *) fail "Linux release packaging currently supports x86_64 only: $(uname -m)" ;;
esac
platform=linux
platform_name=Linux

[ -x "$binary" ] || fail "build CENTL before packaging: make native-build"
[ -x "$physics_binary" ] || fail "build CENTL Physics before packaging: make native-build"
[ -x "$sci_binary" ] || fail "build CENTL-SCi before packaging: make native-build"
[ -x "$mirage_binary" ] || fail "build CENTL-MIRAGE before packaging: make native-build"

reported_version=$("$binary" --version)
[ "$reported_version" = "centl $version" ] ||
  fail "binary reports '$reported_version', expected 'centl $version'"

build_info=$("$binary" --build-info) || fail "binary did not report build identity"
build_info_field() {
  printf '%s\n' "$build_info" | awk -F= -v name="$1" '$1 == name {
    sub(/^[^=]*=/, ""); print; exit
  }'
}
binary_version=$(build_info_field semantic_version)
binary_core_hash=$(build_info_field generated_core_hash)
binary_commit=$(build_info_field commit)
[ "$binary_version" = "$version" ] ||
  fail "build identity version '$binary_version' does not match $version"

linux_dependency_path() {
  pattern=$1
  object=$2
  path=$(ldd "$object" | awk -v pattern="$pattern" \
    '$1 ~ pattern && $2 == "=>" { print $3; exit }')
  [ -n "$path" ] && [ -f "$path" ] ||
    fail "missing runtime library matching $pattern for $object"
  printf '%s\n' "$path"
}

copy_license() {
  destination=$1
  shift
  for source in "$@"; do
    if [ -n "$source" ] && [ -f "$source" ]; then
      cp "$source" "$destination"
      return
    fi
  done
  fail "could not locate license text for $(basename "$destination")"
}

if [ -n "${OPAM_SWITCH_PREFIX:-}" ]; then
  opam_prefix=$OPAM_SWITCH_PREFIX
elif command -v opam >/dev/null 2>&1; then
  opam_prefix=$(opam var --switch="${CENTL_OPAM_SWITCH:-centl}" prefix)
else
  opam_prefix=""
fi

if command -v fstar.exe >/dev/null 2>&1; then
  fstar_executable=$(command -v fstar.exe)
  while [ -L "$fstar_executable" ]; do
    link_directory=$(dirname -- "$fstar_executable")
    link_target=$(readlink "$fstar_executable")
    case "$link_target" in
      /*) fstar_executable=$link_target ;;
      *) fstar_executable="$link_directory/$link_target" ;;
    esac
  done
  fstar_directory=$(CDPATH= cd -- "$(dirname -- "$fstar_executable")" && pwd)
  fstar_license_default="$fstar_directory/../LICENSE"
else
  fstar_license_default=""
fi

temporary=$(mktemp -d "${TMPDIR:-/tmp}/centl-package.XXXXXXXX")
cleanup() {
  rm -rf "$temporary"
}
trap cleanup EXIT HUP INT TERM

package="$temporary/centl"
mkdir -p "$package/bin" "$package/lib" "$package/libexec" "$package/licenses"

for command in centl centl-physics centl-sci centl-mirage; do
  cp "$project_root/scripts/release-launcher" "$package/bin/$command"
done
cp "$binary" "$package/libexec/centl"
cp "$physics_binary" "$package/libexec/centl-physics"
cp "$sci_binary" "$package/libexec/centl-sci"
cp "$mirage_binary" "$package/libexec/centl-mirage"
chmod 755 "$package/bin/centl" "$package/bin/centl-physics" \
  "$package/bin/centl-sci" "$package/bin/centl-mirage" \
  "$package/libexec/centl" "$package/libexec/centl-physics" \
  "$package/libexec/centl-sci" "$package/libexec/centl-mirage"

flint=$(linux_dependency_path '^libflint[.]so' "$binary")
gmp=$(linux_dependency_path '^libgmp[.]so' "$binary")
mpfr=$(linux_dependency_path '^libmpfr[.]so' "$flint")
flint_name=$(basename "$flint")
gmp_name=$(basename "$gmp")
mpfr_name=$(basename "$mpfr")
cp -L "$flint" "$package/lib/$flint_name"
cp -L "$gmp" "$package/lib/$gmp_name"
cp -L "$mpfr" "$package/lib/$mpfr_name"

if command -v strip >/dev/null 2>&1; then
  chmod u+w "$package/libexec/centl" "$package/libexec/centl-physics" \
    "$package/libexec/centl-sci" "$package/libexec/centl-mirage" \
    "$package/lib/$flint_name" "$package/lib/$gmp_name" "$package/lib/$mpfr_name"
  strip --strip-unneeded "$package/libexec/centl" \
    "$package/libexec/centl-physics" "$package/libexec/centl-sci" \
    "$package/libexec/centl-mirage" "$package/lib/$flint_name" \
    "$package/lib/$gmp_name" "$package/lib/$mpfr_name"
fi

cp "$project_root/LICENSE" "$package/licenses/CENTL-Apache-2.0"
cp "$project_root/NOTICE" "$package/NOTICE"
cp "$project_root/LICENSING.md" "$package/LICENSING.md"
cp "$project_root/TRADEMARKS.md" "$package/TRADEMARKS.md"
cp "$project_root/THIRD_PARTY_NOTICES.md" "$package/THIRD_PARTY_NOTICES.md"
copy_license "$package/licenses/FLINT-LGPL-2.1-or-later" \
  "${CENTL_FLINT_LICENSE:-}" /usr/share/common-licenses/LGPL-2.1
copy_license "$package/licenses/GMP-LGPL-3.0-or-later" \
  "${CENTL_GMP_LGPL_LICENSE:-${CENTL_GMP_LICENSE:-}}" \
  /usr/share/common-licenses/LGPL-3
copy_license "$package/licenses/GMP-GPL-3.0" \
  "${CENTL_GMP_GPL3_LICENSE:-}" /usr/share/common-licenses/GPL-3
copy_license "$package/licenses/MPFR-LGPL-3.0-or-later" \
  "${CENTL_MPFR_LGPL_LICENSE:-${CENTL_MPFR_LICENSE:-}}" \
  /usr/share/common-licenses/LGPL-3
copy_license "$package/licenses/MPFR-GPL-3.0" \
  "${CENTL_MPFR_GPL3_LICENSE:-}" /usr/share/common-licenses/GPL-3
copy_license "$package/licenses/FSTAR" \
  "${CENTL_FSTAR_LICENSE:-}" "$fstar_license_default"
copy_license "$package/licenses/OCAML" \
  "${CENTL_OCAML_LICENSE:-}" \
  "$opam_prefix/.opam-switch/sources/ocaml-base-compiler.4.14.1/LICENSE" \
  /usr/share/doc/ocaml/copyright /usr/share/doc/ocaml-base/copyright
copy_license "$package/licenses/ZARITH" \
  "${CENTL_ZARITH_LICENSE:-}" \
  "$opam_prefix/.opam-switch/sources/zarith.1.14/LICENSE" \
  "$opam_prefix/doc/zarith/LICENSE"
copy_license "$package/licenses/YOJSON" \
  "${CENTL_YOJSON_LICENSE:-}" \
  "$opam_prefix/.opam-switch/sources/yojson.2.2.2/LICENSE.md" \
  "$opam_prefix/doc/yojson/LICENSE.md"

cat > "$package/THIRD-PARTY-NOTICES" <<'EOF'
CENTL includes or links components from F*, OCaml, Zarith, Yojson, FLINT, GMP,
and MPFR. Complete license texts are shipped in the licenses directory. Exact
native-library source and relinking references are in COMPONENT-SOURCES.
Build-time-only test dependencies are not included in this archive.
EOF

flint_version=${FLINT_VERSION:-3.0.1}
flint_source_url=${FLINT_SOURCE_URL:-https://github.com/flintlib/flint/releases/download/v${flint_version}/flint-${flint_version}.tar.gz}
flint_source_sha256=${FLINT_SHA256:-unknown}
gmp_version=${GMP_VERSION:-6.3.0}
gmp_source_url=${GMP_SOURCE_URL:-https://ftp.gnu.org/gnu/gmp/gmp-${gmp_version}.tar.xz}
gmp_source_sha256=${GMP_SHA256:-unknown}
mpfr_version=${MPFR_VERSION:-4.2.2}
mpfr_source_url=${MPFR_SOURCE_URL:-https://ftp.gnu.org/gnu/mpfr/mpfr-${mpfr_version}.tar.xz}
mpfr_source_sha256=${MPFR_SHA256:-unknown}

cat > "$package/COMPONENT-SOURCES" <<EOF
CENTL $version corresponding application source and relinking build scripts:
https://github.com/chasebryan/centl/tree/v$version

Exact native-library sources used by the release workflow:
FLINT $flint_version
  $flint_source_url
  sha256 $flint_source_sha256
GMP $gmp_version
  $gmp_source_url
  sha256 $gmp_source_sha256
MPFR $mpfr_version
  $mpfr_source_url
  sha256 $mpfr_source_sha256
EOF

printf '%s\n' "$version" > "$package/VERSION"

build_commit=${CENTL_BUILD_COMMIT:-${SOURCE_COMMIT:-${GITHUB_SHA:-}}}
if command -v sha256sum >/dev/null 2>&1; then
  generated_core_hash=$(
    cat "$project_root/src/generated/Centl_Core.ml" \
      "$project_root/src/generated/Centl_Gcd.ml" \
      "$project_root/src/generated/Centl_PolynomialSoundness.ml" \
      | sha256sum | awk '{ print $1 }'
  )
elif command -v shasum >/dev/null 2>&1; then
  generated_core_hash=$(
    cat "$project_root/src/generated/Centl_Core.ml" \
      "$project_root/src/generated/Centl_Gcd.ml" \
      "$project_root/src/generated/Centl_PolynomialSoundness.ml" \
      | shasum -a 256 | awk '{ print $1 }'
  )
else
  fail "need sha256sum or shasum to stamp generated-core hash"
fi
[ "$binary_core_hash" = "$generated_core_hash" ] ||
  fail "binary generated-core hash does not match packaged sources"
if [ -n "$build_commit" ]; then
  [ "$binary_commit" = "$build_commit" ] ||
    fail "binary commit '$binary_commit' does not match '$build_commit'"
fi

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

{
  printf '{\n'
  printf '  "schema": 1,\n'
  printf '  "kind": "centl_build_manifest",\n'
  printf '  "semantic_version": "%s",\n' "$(json_escape "$version")"
  printf '  "platform": "%s",\n' "$platform"
  printf '  "architecture": "%s",\n' "$architecture"
  if [ -n "$build_commit" ]; then
    printf '  "commit": "%s",\n' "$(json_escape "$build_commit")"
  fi
  printf '  "generated_core_hash": "%s",\n' "$(json_escape "$generated_core_hash")"
  printf '  "commands": ["centl", "centl-physics", "centl-sci", "centl-mirage"],\n'
  printf '  "verification": {"command": "%s", "result": "%s"},\n' \
    "$(json_escape "${CENTL_VERIFICATION_COMMAND:-make verify}")" \
    "$(json_escape "${CENTL_VERIFICATION_RESULT:-not_attested}")"
  printf '  "toolchain": {"fstar": "%s", "ocaml": "%s", "flint": "%s", "gmp": "%s", "mpfr": "%s"},\n' \
    "$(json_escape "${FSTAR_VERSION:-unknown}")" \
    "$(json_escape "${OCAML_VERSION:-4.14.1}")" \
    "$(json_escape "${FLINT_VERSION:-unknown}")" \
    "$(json_escape "${GMP_VERSION:-unknown}")" \
    "$(json_escape "${MPFR_VERSION:-unknown}")"
  printf '  "receipt_schema": 1,\n'
  printf '  "protocol_version": 1\n'
  printf '}\n'
} > "$package/BUILD_MANIFEST.json"

cat > "$package/README" <<EOF
CENTL $version for $platform_name $architecture

Run bin/centl for the mathematical kernel, bin/centl-physics for the exact-first
physics engine, bin/centl-sci for the scientific interaction surface, and
bin/centl-mirage for the local MIRAGE self-development bootstrap. The bundled
native libraries are private to this CENTL release. Use bin/centl --serve for
stateful JSON Lines or --mcp for a local MCP server. CENTL-SCi deterministic
supported problems do not require a model. License texts are in licenses; source
references are in COMPONENT-SOURCES; BUILD_MANIFEST.json records the package
identity and exported command surface.
EOF

find "$package" -type d -exec chmod 755 {} +
find "$package" -type f -exec chmod 644 {} +
chmod 755 "$package/bin/centl" "$package/bin/centl-physics" \
  "$package/bin/centl-sci" "$package/bin/centl-mirage" \
  "$package/libexec/centl" "$package/libexec/centl-physics" \
  "$package/libexec/centl-sci" "$package/libexec/centl-mirage"

"$package/bin/centl" '0.1 + 0.2' | grep -qx '3/10' ||
  fail "packaged CENTL executable failed its smoke test"
"$package/bin/centl-physics" convert 100 cm m | grep -qx '1' ||
  fail "packaged CENTL Physics executable failed its smoke test"
"$package/bin/centl-sci" 'What is 0.1 plus 0.2?' | grep -qx '3/10' ||
  fail "packaged CENTL-SCi executable failed its smoke test"
"$package/bin/centl-mirage" --version | grep -Fqx 'CENTL-MIRAGE development bootstrap' ||
  fail "packaged CENTL-MIRAGE executable failed its smoke test"

mkdir -p "$output_directory"
asset="centl-$platform-$architecture.tar.gz"
archive="$output_directory/$asset"
epoch=${SOURCE_DATE_EPOCH:-0}
case "$epoch" in
  *[!0-9]*|'') fail "SOURCE_DATE_EPOCH must be a non-negative integer" ;;
esac
"$tar_command" --sort=name --mtime="@$epoch" --owner=0 --group=0 \
  --numeric-owner -czf "$archive" -C "$temporary" centl
if command -v sha256sum >/dev/null 2>&1; then
  (cd "$output_directory" && sha256sum "$asset" > "$asset.sha256")
else
  digest=$(shasum -a 256 "$archive" | awk '{ print $1 }')
  printf '%s  %s\n' "$digest" "$asset" > "$archive.sha256"
fi
printf '%s\n' "$archive"
