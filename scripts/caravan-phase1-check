#!/bin/sh
set -eu

PYTHON=${PYTHON:-python3}

"$PYTHON" - <<'PY'
import cryptography
if cryptography.__version__ != "50.0.0":
    raise SystemExit(
        f"CARAVAN Phase 1 requires cryptography 50.0.0, got {cryptography.__version__}"
    )
PY

"$PYTHON" -m py_compile \
  caravan/__init__.py \
  caravan/content.py \
  caravan/coordinator.py \
  caravan/identity.py \
  caravan/policy.py \
  caravan/enrollment.py \
  tests/test_caravan_phase1.py \
  tests/test_caravan_identity.py \
  tests/test_caravan_enrollment.py

PYTHONPATH=. "$PYTHON" -m unittest -v \
  tests/test_caravan_phase1.py \
  tests/test_caravan_identity.py \
  tests/test_caravan_enrollment.py
