#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mirror=${1:-}
work_parent=${2:-${TMPDIR:-/tmp}}

fail() {
  printf 'centl offline-rebuild: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required in the FCF build capsule"
}

[ -n "$mirror" ] || fail "usage: scripts/offline-rebuild MIRROR_DIR [WORK_PARENT]"
mirror=$(CDPATH= cd -- "$mirror" && pwd) || fail "mirror not found: $mirror"
[ -f "$mirror/project/centl.bundle" ] || fail "CENTL bundle missing from mirror"
[ -f "$mirror/project/SOURCE-COMMIT" ] || fail "SOURCE-COMMIT missing from mirror"
[ -f "$mirror/project/SOURCE-SHA256SUMS" ] || fail "SOURCE-SHA256SUMS missing from mirror"

# The outer invocation creates a fresh Linux network namespace. This is stronger
# than merely setting package-manager offline flags: the build process has no
# network interface capable of reaching an upstream host.
if [ "${CENTL_OFFLINE_REBUILD_INNER:-0}" != 1 ]; then
  need unshare
  exec unshare --net --map-root-user \
    env CENTL_OFFLINE_REBUILD_INNER=1 \
    "$0" "$mirror" "$work_parent"
fi

need git
need make
need opam
need python3
need julia
need tar

# A loopback interface is not needed. Refuse an obviously connected namespace
# if a default route somehow survived setup.
if command -v ip >/dev/null 2>&1 && ip route 2>/dev/null | grep -q '^default '; then
  fail "network namespace still has a default route"
fi

"$repo_root/scripts/supply-chain" audit "$mirror"

work=$(mktemp -d "$work_parent/centl-offline-rebuild.XXXXXXXX")
cleanup() {
  rm -rf "$work"
}
trap cleanup EXIT HUP INT TERM

source_dir="$work/centl"
git clone --quiet "$mirror/project/centl.bundle" "$source_dir"
commit=$(sed -n '1p' "$mirror/project/SOURCE-COMMIT")
case "$commit" in
  *[!0-9a-f]*|'') fail "invalid SOURCE-COMMIT" ;;
esac
[ "${#commit}" -eq 40 ] || fail "SOURCE-COMMIT must be a full Git SHA-1"
git -C "$source_dir" checkout --quiet --detach "$commit"
[ "$(git -C "$source_dir" rev-parse HEAD)" = "$commit" ] ||
  fail "recovered checkout does not match SOURCE-COMMIT"

python3 "$source_dir/scripts/integrity.py" verify \
  "$mirror/project/SOURCE-SHA256SUMS" --root "$source_dir"

# Recover the verifier from preserved bytes, not from PATH or an upstream host.
export CENTL_SUPPLY_CHAIN_OFFLINE=1
export CENTL_SOURCE_MIRROR_DIR="$mirror"
"$source_dir/scripts/supply-chain" fetch fstar-linux-x86_64 \
  "$mirror" "$work/fstar.tar.gz" >/dev/null
mkdir -p "$work/fstar"
tar -xzf "$work/fstar.tar.gz" -C "$work/fstar"
fstar=$(find "$work/fstar" -type f -path '*/bin/fstar.exe' -print -quit)
[ -n "$fstar" ] || fail "preserved F* archive contains no fstar.exe"
export FSTAR="$fstar"

# The FCF build capsule must contain the pinned opam switch. Package downloads
# are impossible in this namespace; a missing dependency is therefore a hard
# preservation/capsule failure rather than an upstream fallback.
switch=${CENTL_OPAM_SWITCH:-centl}
opam switch list --short | grep -Fqx "$switch" ||
  fail "FCF build capsule is missing opam switch $switch"

# Use the preserved Julia/Nemo depot. No instantiate/update operation is allowed
# during this gate.
[ -d "$mirror/julia/depot" ] || fail "preserved Julia depot is missing"
export JULIA_DEPOT_PATH="$mirror/julia/depot"
export JULIA_PKG_OFFLINE=true
export JULIA_PKG_PRECOMPILE_AUTO=0
export JULIA_NUM_THREADS=1

cd "$source_dir"
opam exec --switch="$switch" -- make quality
opam exec --switch="$switch" -- make test

CENTL_BIN="$source_dir/_build/default/src/main.exe" \
  julia --startup-file=no --project="$source_dir/lab/julia" \
    "$source_dir/lab/julia/differential.jl"

reported_commit=$(
  "$source_dir/_build/default/src/main.exe" --build-info \
    | sed -n 's/^commit=//p'
)
[ "$reported_commit" = "$commit" ] ||
  fail "rebuilt binary reports commit $reported_commit, expected $commit"

printf 'CENTL offline rebuild gate: PASS\n'
printf 'source_commit=%s\n' "$commit"
printf 'mirror=%s\n' "$mirror"
printf 'network_namespace=isolated\n'
