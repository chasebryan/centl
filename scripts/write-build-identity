#!/bin/sh
# Generate an OCaml build-identity module from the extracted F* core snapshot
# and optional commit metadata. Used by Dune at build time and by packaging.
set -eu

usage() {
  printf 'usage: %s OUTPUT.ml CORE.ml [GCD.ml ...]\n' "$(basename "$0")" >&2
  exit 1
}

[ "$#" -ge 2 ] || usage
output=$1
shift

for source in "$@"; do
  [ -f "$source" ] || {
    printf 'write-build-identity: missing source %s\n' "$source" >&2
    exit 1
  }
done

if command -v sha256sum >/dev/null 2>&1; then
  generated_core_hash=$(cat "$@" | sha256sum | awk '{ print $1 }')
elif command -v shasum >/dev/null 2>&1; then
  generated_core_hash=$(cat "$@" | shasum -a 256 | awk '{ print $1 }')
else
  printf 'write-build-identity: need sha256sum or shasum\n' >&2
  exit 1
fi

# Never infer a clean build identity from a possibly dirty local checkout.
# Release automation supplies one of these immutable source identifiers.
commit=${CENTL_BUILD_COMMIT:-${SOURCE_COMMIT:-${GITHUB_SHA:-}}}

escape_ocaml() {
  # Produce valid OCaml string-literal contents for a hex digest / commit.
  printf '%s' "$1" | sed "s/\\\\/\\\\\\\\/g; s/\"/\\\\\"/g"
}

hash_literal=$(escape_ocaml "$generated_core_hash")
if [ -n "$commit" ]; then
  commit_literal=$(escape_ocaml "$commit")
  commit_expr="Some \"${commit_literal}\""
else
  commit_expr=None
fi

temporary=$(mktemp "${TMPDIR:-/tmp}/centl-build-identity.XXXXXX")
trap 'rm -f "$temporary"' EXIT HUP INT TERM

cat > "$temporary" <<EOF
(* Generated by scripts/write-build-identity. Do not edit by hand. *)

(** Optional source commit for the build that produced this binary. *)
let commit : string option = ${commit_expr}

(** SHA-256 of the concatenated extracted F* OCaml core snapshot files. *)
let generated_core_hash : string option = Some "${hash_literal}"
EOF

if [ -e "$output" ] && cmp -s "$temporary" "$output"; then
  :
else
  # Atomic replace when possible so concurrent dune builds do not race.
  directory=$(dirname -- "$output")
  mkdir -p "$directory"
  mv "$temporary" "$output"
  trap - EXIT HUP INT TERM
fi
