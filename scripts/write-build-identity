#!/bin/sh
# Generate an OCaml build-identity module from the extracted F* core snapshot
# and optional commit metadata. Used by Dune at build time and by packaging.
set -eu

usage() {
  printf 'usage: %s OUTPUT.ml CORE.ml [GCD.ml ...]\n' "$(basename "$0")" >&2
  exit 1
}

[ "$#" -ge 2 ] || usage
output=$1
shift

for source in "$@"; do
  [ -f "$source" ] || {
    printf 'write-build-identity: missing source %s\n' "$source" >&2
    exit 1
  }
done

if command -v sha256sum >/dev/null 2>&1; then
  generated_core_hash=$(cat "$@" | sha256sum | awk '{ print $1 }')
elif command -v shasum >/dev/null 2>&1; then
  generated_core_hash=$(cat "$@" | shasum -a 256 | awk '{ print $1 }')
else
  printf 'write-build-identity: need sha256sum or shasum\n' >&2
  exit 1
fi

# Never infer a clean build identity from a possibly dirty local checkout.
# Release automation supplies one of these immutable source identifiers.
commit=${CENTL_BUILD_COMMIT:-${SOURCE_COMMIT:-${GITHUB_SHA:-}}}

require_hex() {
  label=$1
  value=$2
  case "$value" in
    ''|*[!0-9a-f]*)
      printf 'write-build-identity: %s must be lowercase hexadecimal\n' "$label" >&2
      exit 1
      ;;
  esac
}

require_hex generated_core_hash "$generated_core_hash"
[ "${#generated_core_hash}" -eq 64 ] || {
  printf 'write-build-identity: generated_core_hash must have 64 characters\n' >&2
  exit 1
}

if [ -n "$commit" ]; then
  require_hex commit "$commit"
  case "${#commit}" in
    40|64) ;;
    *)
      printf 'write-build-identity: commit must have 40 or 64 characters\n' >&2
      exit 1
      ;;
  esac
  commit_expr="Some \"${commit}\""
else
  commit_expr=None
fi

directory=$(dirname -- "$output")
mkdir -p "$directory"
cat > "$output" <<EOF
(* Generated by scripts/write-build-identity. Do not edit by hand. *)

(** Optional source commit for the build that produced this binary. *)
let commit : string option = ${commit_expr}

(** SHA-256 of the concatenated extracted F* OCaml core snapshot files. *)
let generated_core_hash : string option = Some "${generated_core_hash}"
EOF

grep -q '^let commit : string option = ' "$output" || {
  printf 'write-build-identity: generated output is missing commit\n' >&2
  exit 1
}
grep -q '^let generated_core_hash : string option = ' "$output" || {
  printf 'write-build-identity: generated output is missing core hash\n' >&2
  exit 1
}
