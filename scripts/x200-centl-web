#!/bin/sh
# Bring the zero-JS CENTL hub up on the X200 and point the named
# Cloudflare/CARAVAN tunnel at it. The X200 is a hosting node only;
# development may happen elsewhere and lands here through the repository.
#
# On the X200:
#   curl -fsSLO https://raw.githubusercontent.com/chasebryan/centl/main/scripts/x200-centl-web
#   sh x200-centl-web
#
# Optional:
#   CENTL_ROOT="$HOME/centl" sh x200-centl-web
set -eu

repo_url="https://github.com/chasebryan/centl.git"
repo_branch="main"
home=${HOME:?HOME must be set for the X200 deployment}
centl_root=${CENTL_ROOT:-$home/centl}
unit_dir=${XDG_CONFIG_HOME:-$home/.config}/systemd/user
cloudflared_dir=$home/.cloudflared
cloudflared_config=$cloudflared_dir/config.yml
tunnel_name=fcf-caravan-coordinator
tunnel_id=d59e3e73-544d-40f8-8ad4-9bb6aa6cd689
cloudflared_credentials=$cloudflared_dir/$tunnel_id.json
hub_port=8088

fail() {
  printf 'x200-centl-web: %s\n' "$*" >&2
  exit 1
}

say() {
  printf 'x200-centl-web: %s\n' "$*"
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required"
}

[ "$(uname -s)" = Linux ] || fail "run this on the X200 GNU/Linux host, not macOS"
PATH="$home/.local/bin:$home/.cargo/bin:$PATH"
export PATH
need git
need systemctl
need curl
need cloudflared

if ! command -v cargo >/dev/null 2>&1; then
  say "cargo not found; installing rustup minimal toolchain"
  need python3
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
  # shellcheck disable=SC1091
  . "$home/.cargo/env"
fi
command -v cargo >/dev/null 2>&1 || fail "cargo is still missing after rustup"

if [ -d "$centl_root/.git" ]; then
  say "updating $centl_root to origin/$repo_branch"
  git -C "$centl_root" remote get-url origin >/dev/null 2>&1 || fail "$centl_root is not a git checkout"
  git -C "$centl_root" fetch --prune origin "$repo_branch"
  git -C "$centl_root" diff --quiet -- && git -C "$centl_root" diff --cached --quiet -- || \
    fail "$centl_root has local changes; commit or stash them, then rerun"
  git -C "$centl_root" checkout "$repo_branch"
  git -C "$centl_root" merge --ff-only "origin/$repo_branch"
else
  parent=$(dirname -- "$centl_root")
  mkdir -p "$parent"
  say "cloning $repo_url into $centl_root"
  git clone --branch "$repo_branch" "$repo_url" "$centl_root"
fi

current_commit=$(git -C "$centl_root" rev-parse HEAD)
say "deploying commit $current_commit"

jobs=2
if [ -r /proc/meminfo ]; then
  mem_kb=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
  if [ -n "${mem_kb:-}" ] && [ "$mem_kb" -lt 1200000 ]; then
    jobs=1
    say "low memory (${mem_kb} kB available); building with one job and no LTO"
  fi
fi
export CARGO_PROFILE_RELEASE_LTO=false
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=4
export CARGO_TERM_COLOR=never

say "building release centl-web"
cargo build --release --jobs "$jobs" --manifest-path "$centl_root/Cargo.toml"
[ -x "$centl_root/target/release/centl-web" ] || fail "centl-web binary missing after build"

mkdir -p "$unit_dir"
cat > "$unit_dir/fcf-centl-web.service" <<EOF_UNIT
[Unit]
Description=FCF CENTL zero-JS web hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$centl_root
Environment=PATH=$home/.cargo/bin:$home/.local/bin:/usr/local/bin:/usr/bin
Environment=CENTL_BIND_HOST=127.0.0.1
Environment=CENTL_SITE_DIR=$centl_root/site
Environment=CENTL_BUILD_COMMIT=$current_commit
ExecStart=$centl_root/target/release/centl-web --serve $hub_port
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
EOF_UNIT

if command -v loginctl >/dev/null 2>&1; then
  loginctl enable-linger "$(id -un)" >/dev/null 2>&1 || \
    say "could not enable linger; start the user session after reboot or run: loginctl enable-linger $(id -un)"
fi

systemctl --user daemon-reload
systemctl --user enable fcf-centl-web.service >/dev/null
systemctl --user restart fcf-centl-web.service

mkdir -p "$cloudflared_dir"
[ -f "$cloudflared_credentials" ] || \
  fail "tunnel credentials missing: $cloudflared_credentials; authenticate/create the named tunnel for this user first"

# This file is intentionally rendered from the runtime home directory. Never copy
# a host-specific credentials path from the repository into the live config.
cat > "$cloudflared_config" <<EOF_TUNNEL
tunnel: $tunnel_id
credentials-file: $cloudflared_credentials

ingress:
  - hostname: caravan.freecomputation.org
    service: http://127.0.0.1:8789
  - hostname: freecomputation.org
    service: http://127.0.0.1:$hub_port
  - hostname: www.freecomputation.org
    service: http://127.0.0.1:$hub_port
  - service: http_status:404
EOF_TUNNEL

cloudflared tunnel --config "$cloudflared_config" ingress validate >/dev/null
matched_rule=$(cloudflared tunnel --config "$cloudflared_config" ingress rule \
  "https://freecomputation.org/__centl_origin" 2>&1 || true)
printf '%s\n' "$matched_rule" | grep -F "service: http://127.0.0.1:$hub_port" >/dev/null || \
  fail "$cloudflared_config does not match freecomputation.org to 127.0.0.1:$hub_port"

cloudflared_bin=$(command -v cloudflared)
cat > "$unit_dir/fcf-caravan-cloudflare-tunnel.service" <<EOF_TUNNEL_UNIT
[Unit]
Description=FCF named Cloudflare Tunnel (X200 origin)
After=fcf-centl-web.service network-online.target
Wants=fcf-centl-web.service network-online.target

[Service]
Type=simple
WorkingDirectory=$centl_root
ExecStart=$cloudflared_bin tunnel --config $cloudflared_config run
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
EOF_TUNNEL_UNIT

systemctl --user daemon-reload
systemctl --user enable fcf-caravan-cloudflare-tunnel.service >/dev/null
systemctl --user restart fcf-caravan-cloudflare-tunnel.service
systemctl --user is-active --quiet fcf-caravan-cloudflare-tunnel.service || \
  fail "fcf-caravan-cloudflare-tunnel.service did not stay active"

cloudflared tunnel route dns "$tunnel_id" freecomputation.org || \
  say "DNS route command did not create freecomputation.org; an existing record may already target this tunnel"
cloudflared tunnel route dns "$tunnel_id" www.freecomputation.org || \
  say "DNS route command did not create www.freecomputation.org; an existing record may already target this tunnel"

ready=0
i=1
while [ "$i" -le 20 ]; do
  local_origin=$(curl --silent --fail --max-time 2 "http://127.0.0.1:$hub_port/__centl_origin" 2>/dev/null || true)
  if [ "$local_origin" = "centl-web $current_commit" ]; then
    ready=1
    break
  fi
  sleep 1
  i=$((i + 1))
done
[ "$ready" -eq 1 ] || fail "local centl-web is not serving build $current_commit on 127.0.0.1:$hub_port"

body=$(mktemp)
cookies=$(mktemp)
trap 'rm -f "$body" "$cookies"' EXIT HUP INT TERM
if ! curl --silent --fail --location --max-time 10 \
  --cookie-jar "$cookies" --cookie "$cookies" \
  --data 'cmd=1/3+%2B+5/7' "http://127.0.0.1:$hub_port/hub" > "$body"; then
  fail "local POST/redirect/get cycle to the CENTL /hub endpoint failed"
fi
if ! grep -q '22/21' "$body"; then
  fail "local calculation did not return 22/21 after its redirect"
fi
if ! curl --silent --fail --max-time 5 --cookie "$cookies" \
  "http://127.0.0.1:$hub_port/hub" > "$body"; then
  fail "local clean GET to /hub failed"
fi
if grep -q '22/21' "$body"; then
  fail "clean GET /hub retained calculation history; refresh semantics are broken"
fi
if ! grep -q 'CENTL exact mathematical interpreter ready.' "$body"; then
  fail "clean GET /hub did not return a pristine calculator"
fi

public_ready=0
i=1
while [ "$i" -le 15 ]; do
  public_origin=$(curl --silent --fail --max-time 5 \
    "https://freecomputation.org/__centl_origin" 2>/dev/null || true)
  if [ "$public_origin" = "centl-web $current_commit" ]; then
    public_ready=1
    break
  fi
  sleep 2
  i=$((i + 1))
done
if [ "$public_ready" -ne 1 ]; then
  fail "freecomputation.org is not reaching this X200 build ($current_commit). Check the Cloudflare DNS record and the $tunnel_name connector before debugging CENTL itself."
fi

rm -f "$body" "$cookies"
trap - EXIT HUP INT TERM
say "local hub is live and refresh-clears: POST 1/3 + 5/7 -> 22/21; clean GET -> pristine"
say "public origin verified: freecomputation.org -> X200 build $current_commit"
say "services: systemctl --user status fcf-centl-web.service fcf-caravan-cloudflare-tunnel.service"
