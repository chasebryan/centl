#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
release_dir=${1:-"$repo_root/dist"}
secret_key=${FCF_SIGNIFY_SECRET_KEY:-}
public_key=${FCF_SIGNIFY_PUBLIC_KEY:-}

fail() {
  printf 'centl release-sign: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required"
}

[ -d "$release_dir" ] || fail "release directory not found: $release_dir"
[ -n "$secret_key" ] || fail "FCF_SIGNIFY_SECRET_KEY must name the protected secret key"
[ -f "$secret_key" ] || fail "secret key not found: $secret_key"
[ -n "$public_key" ] || fail "FCF_SIGNIFY_PUBLIC_KEY must name the matching public key"
[ -f "$public_key" ] || fail "public key not found: $public_key"
need signify
need python3

secret_dir=$(CDPATH= cd -- "$(dirname -- "$secret_key")" && pwd)
secret_abs="$secret_dir/$(basename -- "$secret_key")"
case "$secret_abs" in
  "$repo_root"|"$repo_root"/*)
    fail "refusing to use a release secret key stored inside the CENTL repository"
    ;;
esac

manifest="$release_dir/SHA256SUMS"
signature="$release_dir/SHA256SUMS.sig"

set --
for path in "$release_dir"/centl-*.tar.gz "$release_dir"/centl-*.zip; do
  [ -f "$path" ] || continue
  set -- "$@" "$(basename -- "$path")"
done
[ "$#" -gt 0 ] || fail "no CENTL release archives found in $release_dir"

python3 "$repo_root/scripts/integrity.py" manifest \
  --root "$release_dir" \
  --output "$manifest" \
  "$@"

rm -f "$signature"
signify -S -s "$secret_key" -m "$manifest" -x "$signature"

# A signing operation is not considered complete until the output verifies with
# the explicitly selected public key and the checksum manifest verifies the
# release bytes.
signify -V -p "$public_key" -m "$manifest" -x "$signature"
python3 "$repo_root/scripts/integrity.py" verify "$manifest" --root "$release_dir"

printf 'Signed CENTL release manifest: %s\n' "$manifest"
printf 'Signature: %s\n' "$signature"
printf 'Public key: %s\n' "$public_key"
