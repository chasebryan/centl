#!/bin/sh
set -eu

repository="chasebryan/centl"
release_version="latest"
release_base_url=${CENTL_RELEASE_BASE_URL:-}
archive_path=""
prefix=${CENTL_PREFIX:-}
configure_path=true

usage() {
  cat <<'EOF'
Install a prebuilt CENTL release on GNU/Linux.

Usage: ./install [--version VERSION] [--release-base-url URL] [--prefix PATH] [--archive PATH] [--no-path]

  --version VERSION          install a specific release (default: latest)
  --release-base-url URL     use URL/vVERSION as the release directory
                             (HTTPS or file://; requires explicit --version)
  --prefix PATH              install below PATH (default: ~/.local)
  --archive PATH             install and verify a local Linux release archive
  --no-path                  do not update a shell startup file when PATH needs setup
  --help                     show this help

Environment:
  CENTL_RELEASE_BASE_URL     same as --release-base-url
  CENTL_PREFIX               same as --prefix
EOF
}

fail() {
  printf 'centl install: %s\n' "$1" >&2
  exit 1
}

shell_quote() {
  escaped=$(printf '%s' "$1" | sed "s/'/'\\\\''/g")
  printf "'%s'" "$escaped"
}

exported_shell_path() {
  if export -p | grep -Eq '^(export SHELL=|declare -x SHELL=)'; then
    printf '%s\n' "${SHELL:-}"
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version)
      [ "$#" -ge 2 ] || fail "--version needs a value"
      release_version=$2
      shift 2
      ;;
    --release-base-url)
      [ "$#" -ge 2 ] || fail "--release-base-url needs a URL"
      release_base_url=$2
      shift 2
      ;;
    --prefix)
      [ "$#" -ge 2 ] || fail "--prefix needs a path"
      prefix=$2
      shift 2
      ;;
    --archive)
      [ "$#" -ge 2 ] || fail "--archive needs a path"
      archive_path=$2
      shift 2
      ;;
    --no-path)
      configure_path=false
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *) fail "unknown option: $1" ;;
  esac
done

[ -n "$prefix" ] || {
  [ -n "${HOME:-}" ] || fail "HOME is not set; use --prefix PATH"
  prefix="$HOME/.local"
}
[ -n "$prefix" ] || fail "the installation prefix cannot be empty"
case "$prefix" in
  *'
'*) fail "the installation prefix cannot contain a newline" ;;
  /*) ;;
  *) prefix="$(pwd)/$prefix" ;;
esac

if [ -n "$archive_path" ] && [ -n "$release_base_url" ]; then
  fail "--archive and --release-base-url are mutually exclusive"
fi
if [ -n "$release_base_url" ]; then
  case "$release_base_url" in
    *'
'*) fail "the release base URL cannot contain a newline" ;;
    https://*|file://*) ;;
    *) fail "the release base URL must use https:// or file://" ;;
  esac
  [ "$release_version" != latest ] ||
    fail "a custom release base URL requires an explicit --version"
  requested_release=${release_version#v}
  case "$requested_release" in
    ''|*/*|*..*|*[!0-9A-Za-z.+_-]*) fail "the requested release version is invalid" ;;
  esac
fi

case $(uname -s) in
  Linux) platform=linux ;;
  Darwin) fail "macOS is currently unsupported; CENTL native releases are GNU/Linux only" ;;
  *) fail "CENTL native releases currently support GNU/Linux only" ;;
esac

case $(uname -m) in
  x86_64|amd64) architecture=x86_64 ;;
  *) fail "Linux prebuilt releases currently support x86_64 only: $(uname -m)" ;;
esac

asset="centl-${platform}-${architecture}.tar.gz"
temporary=$(mktemp -d "${TMPDIR:-/tmp}/centl-install.XXXXXXXX")
staging=""
cleanup() {
  rm -rf "$temporary"
  if [ -n "$staging" ] && [ -d "$staging" ]; then
    rm -rf "$staging"
  fi
}
trap cleanup EXIT HUP INT TERM

archive="$temporary/$asset"
checksum="$temporary/$asset.sha256"

if [ -n "$archive_path" ]; then
  [ -f "$archive_path" ] || fail "archive not found: $archive_path"
  [ -f "$archive_path.sha256" ] ||
    fail "checksum not found: $archive_path.sha256"
  cp "$archive_path" "$archive"
  cp "$archive_path.sha256" "$checksum"
else
  if [ -n "$release_base_url" ]; then
    base_url="${release_base_url%/}/v$requested_release"
  else
    case "$release_version" in
      latest) release_path=latest/download ;;
      v*) release_path="download/$release_version" ;;
      *) release_path="download/v$release_version" ;;
    esac
    base_url="https://github.com/$repository/releases/$release_path"
  fi
  command -v curl >/dev/null 2>&1 || fail "curl is required to download CENTL"
  printf 'Downloading CENTL %s for %s-%s...\n' \
    "$release_version" "$platform" "$architecture"
  curl --fail --silent --show-error --location \
    "$base_url/$asset" --output "$archive"
  curl --fail --silent --show-error --location \
    "$base_url/$asset.sha256" --output "$checksum"
fi

expected=$(awk 'NR == 1 { print $1 }' "$checksum")
case "$expected" in
  *[!0-9a-fA-F]*|'') fail "the release checksum is malformed" ;;
esac
[ "${#expected}" -eq 64 ] || fail "the release checksum is malformed"
expected=$(printf '%s' "$expected" | tr 'A-F' 'a-f')

if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$archive" | awk '{ print $1 }')
elif command -v shasum >/dev/null 2>&1; then
  actual=$(shasum -a 256 "$archive" | awk '{ print $1 }')
else
  fail "sha256sum or shasum is required to verify CENTL"
fi
[ "$actual" = "$expected" ] || fail "release checksum verification failed"

extracted="$temporary/extracted"
mkdir "$extracted"
tar -tzf "$archive" | while IFS= read -r member; do
  case "$member" in
    /*|../*|*/../*|*/..) fail "the release archive contains an unsafe path" ;;
    centl|centl/*) ;;
    *) fail "the release archive has an unexpected layout" ;;
  esac
done
tar -xzf "$archive" -C "$extracted"
package="$extracted/centl"
[ -x "$package/bin/centl" ] || fail "the release contains no CENTL launcher"
[ -x "$package/libexec/centl" ] || fail "the release contains no CENTL executable"
[ -f "$package/VERSION" ] || fail "the release contains no version metadata"

physics_available=false
if [ -e "$package/bin/centl-physics" ] || [ -e "$package/libexec/centl-physics" ]; then
  [ -x "$package/bin/centl-physics" ] ||
    fail "the release contains an invalid CENTL Physics launcher"
  [ -x "$package/libexec/centl-physics" ] ||
    fail "the release contains an invalid CENTL Physics executable"
  physics_available=true
fi

sci_available=false
if [ -e "$package/bin/centl-sci" ] || [ -e "$package/libexec/centl-sci" ]; then
  [ -x "$package/bin/centl-sci" ] ||
    fail "the release contains an invalid CENTL-SCi launcher"
  [ -x "$package/libexec/centl-sci" ] ||
    fail "the release contains an invalid CENTL-SCi executable"
  sci_available=true
fi

version=$(sed -n '1p' "$package/VERSION")
case "$version" in
  ''|*/*|*..*|*[!0-9A-Za-z.+_-]*) fail "the release version is invalid" ;;
esac
if [ "$release_version" != latest ]; then
  requested=${release_version#v}
  [ "$version" = "$requested" ] ||
    fail "requested $requested but the archive contains $version"
fi

versions="$prefix/share/centl/versions"
target="$versions/$version"
bin_directory="$prefix/bin"
command_path="$bin_directory/centl"
physics_command_path="$bin_directory/centl-physics"
sci_command_path="$bin_directory/centl-sci"

if [ -e "$command_path" ] && [ ! -L "$command_path" ]; then
  fail "$command_path already exists and is not a symbolic link"
fi
if [ "$physics_available" = true ] && \
   [ -e "$physics_command_path" ] && [ ! -L "$physics_command_path" ]; then
  fail "$physics_command_path already exists and is not a symbolic link"
fi
if [ "$sci_available" = true ] && \
   [ -e "$sci_command_path" ] && [ ! -L "$sci_command_path" ]; then
  fail "$sci_command_path already exists and is not a symbolic link"
fi

mkdir -p "$versions" "$bin_directory"
if [ -e "$target" ]; then
  fail "CENTL $version is already installed at $target"
fi

# Copy onto the destination filesystem, validate there, then activate with one
# rename. An interrupted copy cannot become the active CENTL installation.
staging=$(mktemp -d "$versions/.centl-$version.XXXXXXXX")
cp -R "$package/." "$staging/"
if ! runtime_version=$("$staging/bin/centl" --version 2>&1); then
  fail "the CENTL executable cannot run on this system: $runtime_version"
fi
[ "$runtime_version" = "centl $version" ] ||
  fail "the executable reports '$runtime_version', expected 'centl $version'"
if [ "$physics_available" = true ]; then
  if ! physics_smoke=$("$staging/bin/centl-physics" convert 100 cm m 2>&1); then
    fail "the CENTL Physics executable cannot run on this system: $physics_smoke"
  fi
  [ "$physics_smoke" = 1 ] ||
    fail "the CENTL Physics executable failed its unit-conversion smoke test"
fi
if [ "$sci_available" = true ]; then
  if ! sci_smoke=$("$staging/bin/centl-sci" 'What is 0.1 plus 0.2?' 2>&1); then
    fail "the CENTL-SCi executable cannot run on this system: $sci_smoke"
  fi
  [ "$sci_smoke" = '3/10' ] ||
    fail "the CENTL-SCi executable failed its exact-arithmetic smoke test"
  if ! sci_repl_smoke=$(printf ':exit\n' | "$staging/bin/centl-sci" --repl 2>&1); then
    fail "the CENTL-SCi REPL cannot start on this system: $sci_repl_smoke"
  fi
  printf '%s\n' "$sci_repl_smoke" | grep -Eq '^CENTL-SCi v' ||
    fail "the CENTL-SCi REPL did not report its identity"
  printf '%s\n' "$sci_repl_smoke" | grep -Fqx 'Free for science.' ||
    fail "the CENTL-SCi REPL did not report its scientific identity"
fi
mv "$staging" "$target"
staging=""
ln -sfn "$target/bin/centl" "$command_path"
if [ "$physics_available" = true ]; then
  ln -sfn "$target/bin/centl-physics" "$physics_command_path"
fi
if [ "$sci_available" = true ]; then
  ln -sfn "$target/bin/centl-sci" "$sci_command_path"
fi

path_profile=""
case ":${PATH:-}:" in
  *":$bin_directory:"*) path_active=true ;;
  *) path_active=false ;;
esac

if [ "$path_active" = false ] && [ "$configure_path" = true ] && [ -n "${HOME:-}" ]; then
  shell_path=$(exported_shell_path)
  shell_name=${shell_path##*/}
  case "$shell_name" in
    bash) profile="$HOME/.bashrc" ;;
    zsh) profile="$HOME/.zshrc" ;;
    *) profile="$HOME/.profile" ;;
  esac
  marker="# CENTL PATH: $bin_directory"
  if [ ! -f "$profile" ] || ! grep -Fqx "$marker" "$profile"; then
    quoted_bin=$(shell_quote "$bin_directory")
    {
      printf '\n%s\n' "$marker"
      printf 'export PATH=%s:"$PATH"\n' "$quoted_bin"
    } >> "$profile"
  fi
  path_profile=$profile
fi

printf 'Installed CENTL %s at %s\n' "$version" "$target"
printf 'Command: %s\n' "$command_path"
if [ "$physics_available" = true ]; then
  printf 'Physics command: %s\n' "$physics_command_path"
fi
if [ "$sci_available" = true ]; then
  printf 'Scientific command: %s\n' "$sci_command_path"
  printf '\nCENTL-SCi is ready.\n'
  if [ "$path_active" = true ]; then
    printf 'Start: centl-sci\n'
  elif [ -n "$path_profile" ]; then
    printf 'PATH configured in %s for new shells.\n' "$path_profile"
    printf 'Open a new terminal and run: centl-sci\n'
    printf 'Or start now with:\n  export PATH=%s:"$PATH"\n  centl-sci\n' \
      "$(shell_quote "$bin_directory")"
  else
    printf 'Add %s to PATH, then run: centl-sci\n' "$bin_directory"
  fi
else
  printf '\nCENTL-SCi is not included in CENTL %s.\n' "$version"
fi
