#!/bin/sh
set -eu

repository="chasebryan/centl"
release_version="latest"
release_base_url=${CENTL_RELEASE_BASE_URL:-}
archive_path=""
prefix=${CENTL_PREFIX:-}
configure_path=true

usage() {
  cat <<'EOF'
Install a prebuilt CENTL release on GNU/Linux.

Usage: ./install [--version VERSION] [--release-base-url URL] [--prefix PATH] [--archive PATH] [--no-path]

  --version VERSION          install a specific release (default: latest)
  --release-base-url URL     use URL/vVERSION as the release directory
                             (HTTPS or file://; requires explicit --version)
  --prefix PATH              install below PATH (default: ~/.local)
  --archive PATH             install and verify a local Linux release archive
  --no-path                  do not update a shell startup file when PATH needs setup
  --help                     show this help

Environment:
  CENTL_RELEASE_BASE_URL     same as --release-base-url
  CENTL_PREFIX               same as --prefix
EOF
}

fail() {
  printf 'centl install: %s\n' "$1" >&2
  exit 1
}

shell_quote() {
  escaped=$(printf '%s' "$1" | sed "s/'/'\\\\''/g")
  printf "'%s'" "$escaped"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --version)
      [ "$#" -ge 2 ] || fail "--version needs a value"
      release_version=$2
      shift 2
      ;;
    --release-base-url)
      [ "$#" -ge 2 ] || fail "--release-base-url needs a URL"
      release_base_url=$2
      shift 2
      ;;
    --prefix)
      [ "$#" -ge 2 ] || fail "--prefix needs a path"
      prefix=$2
      shift 2
      ;;
    --archive)
      [ "$#" -ge 2 ] || fail "--archive needs a path"
      archive_path=$2
      shift 2
      ;;
    --no-path)
      configure_path=false
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *) fail "unknown option: $1" ;;
  esac
done

[ -n "$prefix" ] || {
  [ -n "${HOME:-}" ] || fail "HOME is not set; use --prefix PATH"
  prefix="$HOME/.local"
}
[ -n "$prefix" ] || fail "the installation prefix cannot be empty"
case "$prefix" in
  *'
'*) fail "the installation prefix cannot contain a newline" ;;
  /*) ;;
  *) prefix="$(pwd)/$prefix" ;;
esac

if [ -n "$archive_path" ] && [ -n "$release_base_url" ]; then
  fail "--archive and --release-base-url are mutually exclusive"
fi
if [ -n "$release_base_url" ]; then
  case "$release_base_url" in
    *'
'*) fail "the release base URL cannot contain a newline" ;;
    https://*|file://*) ;;
    *) fail "the release base URL must use https:// or file://" ;;
  esac
  [ "$release_version" != latest ] ||
    fail "a custom release base URL requires an explicit --version"
  requested_release=${release_version#v}
  case "$requested_release" in
    ''|*/*|*..*|*[!0-9A-Za-z.+_-]*) fail "the requested release version is invalid" ;;
  esac
fi

case $(uname -s) in
  Linux) platform=linux ;;
  Darwin) fail "macOS is currently unsupported; CENTL releases are GNU/Linux only" ;;
  *) fail "this installer currently supports GNU/Linux only" ;;
esac

case $(uname -m) in
  x86_64|amd64) architecture=x86_64 ;;
  *) fail "Linux prebuilt releases currently support x86_64 only: $(uname -m)" ;;
esac

asset="centl-${platform}-${architecture}.tar.gz"
temporary=$(mktemp -d "${TMPDIR:-/tmp}/centl-install.XXXXXXXX")
staging=""
cleanup() {
  rm -rf "$temporary"
  if [ -n "$staging" ] && [ -d "$staging" ]; then
    rm -rf "$staging"
  fi
}
trap cleanup EXIT HUP INT TERM

archive="$temporary/$asset"
checksum="$temporary/$asset.sha256"

if [ -n "$archive_path" ]; then
  [ -f "$archive_path" ] || fail "archive not found: $archive_path"
  [ -f "$archive_path.sha256" ] ||
    fail "checksum not found: $archive_path.sha256"
  cp "$archive_path" "$archive"
  cp "$archive_path.sha256" "$checksum"
else
  if [ -n "$release_base_url" ]; then
    base_url="${release_base_url%/}/v$requested_release"
  else
    case "$release_version" in
      latest) release_path=latest/download ;;
      v*) release_path="download/$release_version" ;;
      *) release_path="download/v$release_version" ;;
    esac
    base_url="https://github.com/$repository/releases/$release_path"
  fi
  command -v curl >/dev/null 2>&1 || fail "curl is required to download CENTL"
  printf 'Downloading CENTL %s for %s-%s...\n' \
    "$release_version" "$platform" "$architecture"
  curl --fail --silent --show-error --location \
    "$base_url/$asset" --output "$archive"
  curl --fail --silent --show-error --location \
    "$base_url/$asset.sha256" --output "$checksum"
fi

expected=$(awk 'NR == 1 { print $1 }' "$checksum")
case "$expected" in
  *[!0-9a-fA-F]*|'') fail "the release checksum is malformed" ;;
esac
[ "${#expected}" -eq 64 ] || fail "the release checksum is malformed"
expected=$(printf '%s' "$expected" | tr 'A-F' 'a-f')

if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$archive" | awk '{ print $1 }')
elif command -v shasum >/dev/null 2>&1; then
  actual=$(shasum -a 256 "$archive" | awk '{ print $1 }')
else
  fail "sha256sum or shasum is required to verify CENTL"
fi
[ "$actual" = "$expected" ] || fail "release checksum verification failed"

extracted="$temporary/extracted"
mkdir "$extracted"
tar -tzf "$archive" | while IFS= read -r member; do
  case "$member" in
    /*|../*|*/../*|*/..) fail "the release archive contains an unsafe path" ;;
  esac
done
tar -xzf "$archive" -C "$extracted"

package_root=$(find "$extracted" -mindepth 1 -maxdepth 1 -type d -print -quit)
[ -n "$package_root" ] || fail "release archive did not contain a package directory"
[ -x "$package_root/bin/centl" ] || fail "release archive is missing bin/centl"

version=$(
  if [ -f "$package_root/VERSION" ]; then
    sed -n '1p' "$package_root/VERSION"
  else
    "$package_root/bin/centl" --version | sed 's/^centl //'
  fi
)
[ -n "$version" ] || fail "could not determine the release version"

releases="$prefix/lib/centl/releases"
bin_dir="$prefix/bin"
mkdir -p "$releases" "$bin_dir"
staging="$releases/.staging-$version-$$"
rm -rf "$staging"
mkdir "$staging"
cp -R "$package_root"/. "$staging"/

"$staging/bin/centl" --version >/dev/null
if [ -x "$staging/bin/centl-physics" ]; then
  "$staging/bin/centl-physics" convert 100 cm m | grep -qx '1' ||
    fail "CENTL Physics smoke test failed"
fi
if [ -x "$staging/bin/centl-sci" ]; then
  "$staging/bin/centl-sci" 'What is 0.1 plus 0.2?' | grep -qx '3/10' ||
    fail "CENTL-SCi exact arithmetic smoke test failed"
  repl_output=$(printf ':exit\n' | "$staging/bin/centl-sci" --repl)
  printf '%s\n' "$repl_output" | grep -q '^CENTL-SCi v' ||
    fail "CENTL-SCi REPL identity smoke test failed"
  printf '%s\n' "$repl_output" | grep -q '^Free for science\.$' ||
    fail "CENTL-SCi REPL startup smoke test failed"
fi

release_root="$releases/$version"
rm -rf "$release_root"
mv "$staging" "$release_root"
staging=""

activate() {
  command=$1
  [ -x "$release_root/bin/$command" ] || return 0
  ln -sfn "$release_root/bin/$command" "$bin_dir/$command"
}
activate centl
activate centl-physics
activate centl-sci

path_ready=false
case ":${PATH:-}:" in
  *:"$bin_dir":*) path_ready=true ;;
esac

path_file=""
if [ "$configure_path" = true ] && [ "$path_ready" = false ]; then
  shell_name=${SHELL##*/}
  case "$shell_name" in
    bash) path_file="$HOME/.bashrc" ;;
    zsh) path_file="$HOME/.zshrc" ;;
    *) path_file="$HOME/.profile" ;;
  esac
  marker="# CENTL PATH: $bin_dir"
  if [ ! -f "$path_file" ] || ! grep -Fqx "$marker" "$path_file"; then
    {
      printf '\n%s\n' "$marker"
      printf 'export PATH=%s:"$PATH"\n' "$(shell_quote "$bin_dir")"
    } >> "$path_file"
  fi
fi

printf 'CENTL %s installed at %s\n' "$version" "$release_root"
printf 'Command directory: %s\n' "$bin_dir"
if [ -x "$release_root/bin/centl-sci" ]; then
  printf 'CENTL-SCi is ready.\n'
  printf 'Scientific command: %s\n' "$bin_dir/centl-sci"
fi
if [ "$path_ready" = true ]; then
  printf 'Run: centl-sci\n'
elif [ "$configure_path" = true ]; then
  printf 'PATH configured in %s\n' "$path_file"
  printf 'Open a new terminal and run: centl-sci\n'
else
  printf 'Add %s to PATH, then run: centl-sci\n' "$bin_dir"
fi
