(include_subdirs unqualified)

(rule
 (target centl_build.ml)
 (deps
  (universe)
  ../scripts/write-build-identity
  generated/Centl_Core.ml
  generated/Centl_Gcd.ml
  generated/Centl_PolynomialSoundness.ml)
 (action
  (run
   %{env:CENTL_BUILD_IDENTITY_SHELL=sh}
   %{dep:../scripts/write-build-identity}
   %{target}
   %{dep:generated/Centl_Core.ml}
   %{dep:generated/Centl_Gcd.ml}
   %{dep:generated/Centl_PolynomialSoundness.ml})))

