[Unit]
Description=FCF CENTL zero-JS web hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/home/chasebryan/centl
Environment=PATH=/var/home/chasebryan/.cargo/bin:/var/home/chasebryan/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/var/home/chasebryan/centl/target/release/centl-web --serve 8088
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
