[Unit]
Description=FCF CARAVAN named Cloudflare Tunnel
After=fcf-caravan-coordinator.service fcf-centl-web.service network-online.target
Wants=fcf-caravan-coordinator.service fcf-centl-web.service

[Service]
Type=simple
WorkingDirectory=%h/centl
ExecStart=/usr/bin/env cloudflared tunnel --config %h/.cloudflared/config.yml run
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
