# Generated by scripts/caravan-public-origin-install.
# Static CENTL/FCF cargo only. No proxy_pass, CGI, WebDAV, uploads, or arbitrary
# filesystem aliases belong in this virtual host.

limit_req_zone $binary_remote_addr zone=fcf_caravan_req:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=fcf_caravan_conn:10m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    access_log off;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name @@DOMAIN@@;
    access_log off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_certificate /etc/letsencrypt/live/@@DOMAIN@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@DOMAIN@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    access_log off;
    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @@DOMAIN@@;

    ssl_certificate /etc/letsencrypt/live/@@DOMAIN@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@DOMAIN@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    root /srv/fcf-caravan-live/current;
    index index.html;
    autoindex off;
    server_tokens off;
    access_log off;
    error_log /var/log/nginx/fcf-caravan-error.log warn;

    client_max_body_size 1k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    keepalive_timeout 20s;
    send_timeout 120s;
    reset_timedout_connection on;
    max_ranges 1;
    etag on;

    limit_req zone=fcf_caravan_req burst=30 nodelay;
    limit_conn fcf_caravan_conn 4;
    limit_rate_after 4m;
    limit_rate 8m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" always;

    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }

    location = / {
        try_files /index.html =404;
    }
    location = /index.html {
        try_files $uri =404;
    }
    location = /robots.txt {
        try_files $uri =404;
    }
    location = /status.json {
        default_type application/json;
        try_files $uri =404;
    }
    location = /SHA256SUMS {
        default_type text/plain;
        try_files $uri =404;
    }
    location = /source/INDEX.json {
        default_type application/json;
        try_files $uri =404;
    }
    location = /source/centl-main.tar.gz {
        default_type application/gzip;
        try_files $uri =404;
    }
    location = /source/centl-oasis.tar.gz {
        default_type application/gzip;
        try_files $uri =404;
    }
    location = /source/centl-mirage.tar.gz {
        default_type application/gzip;
        try_files $uri =404;
    }
    location = /caravan/catalog-v1.json {
        default_type application/json;
        try_files $uri =404;
    }
    location = /caravan/CATALOG-STATUS {
        default_type text/plain;
        try_files $uri =404;
    }
    location = /caravan/INGEST-STATUS.json {
        default_type application/json;
        try_files $uri =404;
    }

    # These trees are not writable by nginx and are present only when the
    # networkless FCF publication gates approved them. Directory listing stays off.
    location ^~ /releases/ {
        default_type application/octet-stream;
        try_files $uri =404;
    }
    location ^~ /semantic/ {
        default_type application/octet-stream;
        try_files $uri =404;
    }

    # Default deny. If a future artifact family is intended for publication, it
    # must be added deliberately here and to the activation gate.
    location / {
        return 404;
    }
}
