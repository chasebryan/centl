[Unit]
Description=FCF CARAVAN dedicated nftables boundary
DefaultDependencies=no
Before=network-pre.target nginx.service
Wants=network-pre.target
ConditionPathExists=/etc/fcf-caravan/nftables.conf

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/fcf-caravan/caravan-public-origin-firewall
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
