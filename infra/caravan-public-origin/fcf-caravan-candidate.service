[Unit]
Description=FCF CARAVAN unprivileged public-origin candidate builder
After=network-online.target fcf-caravan-ingest.service
Wants=network-online.target
ConditionPathExists=/etc/fcf-caravan/public-origin.env

[Service]
Type=oneshot
User=fcf-caravan
Group=fcf-caravan
EnvironmentFile=/etc/fcf-caravan/public-origin.env
ExecStart=/usr/bin/flock --exclusive /run/lock/fcf-caravan-publication.lock /usr/local/libexec/fcf-caravan/caravan-public-origin-candidate.py
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/var/lib/fcf-caravan/approved /run/lock/fcf-caravan-publication.lock
ReadWritePaths=/var/lib/fcf-caravan/source-state /var/lib/fcf-caravan/candidates
TasksMax=128
MemoryMax=1G
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
