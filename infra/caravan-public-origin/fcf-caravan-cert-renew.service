[Unit]
Description=FCF CARAVAN certificate renewal
After=network-online.target nginx.service fcf-caravan-firewall.service
Wants=network-online.target
ConditionPathExists=/etc/fcf-caravan/public-origin.env

[Service]
Type=oneshot
ExecStart=/usr/bin/env certbot renew --quiet --deploy-hook /usr/local/libexec/fcf-caravan/caravan-public-origin-cert-deploy
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt
