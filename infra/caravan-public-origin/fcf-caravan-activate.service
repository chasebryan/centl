[Unit]
Description=FCF CARAVAN networkless root activation gate
After=local-fs.target
ConditionPathExists=/etc/fcf-caravan/public-origin.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/fcf-caravan/public-origin.env
ExecStart=/usr/local/libexec/fcf-caravan/caravan-public-origin-activate-gate
UMask=0022
PrivateNetwork=yes
IPAddressDeny=any
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
AmbientCapabilities=
# Candidate claiming uses rename(2) from candidates/ into activation-inbox/.
# Both paths must therefore remain inside one writable mount namespace. Keep the
# common /var/lib/fcf-caravan parent writable for that atomic handoff, then mask
# every non-handoff state subtree read-only again below it.
ReadOnlyPaths=/var/lib/fcf-caravan/approved /var/lib/fcf-caravan/source-state /var/lib/fcf-caravan/ingest-work /run/lock/fcf-caravan-publication.lock
ReadWritePaths=/var/lib/fcf-caravan /srv/fcf-caravan-live
TasksMax=64
MemoryMax=1G
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
