[Unit]
Description=FCF CARAVAN networkless preservation publication ingest
After=local-fs.target
ConditionPathExists=/etc/fcf-caravan/ingest.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/fcf-caravan/ingest.env
ExecStart=/usr/local/libexec/fcf-caravan/caravan-public-origin-ingest
UMask=0022
PrivateNetwork=yes
IPAddressDeny=any
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
ReadWritePaths=/var/lib/fcf-caravan
TasksMax=64
MemoryMax=1G
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
