# Absolute path to the CENTL checkout that owns the verification scripts.
CENTL_REPO=/absolute/path/to/centl

# Primary FCF-controlled preservation mirror.
CENTL_MIRROR=/srv/centl-mirror

# Optional independent second copy. Leave empty only until a second copy exists.
CENTL_SECONDARY_MIRROR=/mnt/fcf-backup/centl-mirror

# verify = audit + primary receipt + secondary comparison
# full   = verify plus the saved OCI no-network rebuild/test gate
CENTL_DRILL_MODE=verify

# Must be outside every preservation mirror so reports do not invalidate receipts.
CENTL_DRILL_REPORT_DIR=/absolute/path/to/centl-preservation-reports
