# Exact algebraic contracts for the one-shot Erdős–Straus attack.
#
# These certify algebraic identities only. They do NOT certify the universal
# existence, integrality, positivity, primality, or divisor conditions on the
# parameters appearing in the theorem statements.
#
# IMPORTANT: each fraction-family contract substitutes P = m*p first.  The
# previous draft incorrectly treated p as independent of the defining family.

# ---------------------------------------------------------------------------
# 4p+1 factor family
# P = p = 4*u*v-u-v.
# Then 4/P = 1/(u*v) + 1/(P*u) + 1/(P*v).
# ---------------------------------------------------------------------------
equal | 4*(u*v)*((4*u*v-u-v)*u)*((4*u*v-u-v)*v) | (4*u*v-u-v)*((4*u*v-u-v)*u)*((4*u*v-u-v)*v) + (4*u*v-u-v)*(u*v)*((4*u*v-u-v)*v) + (4*u*v-u-v)*(u*v)*((4*u*v-u-v)*u) | u:rational v:rational

# Equivalent factorization identity:
# (4u-1)(4v-1) = 4P+1.
equal | (4*u-1)*(4*v-1) | 4*(4*u*v-u-v)+1 | u:rational v:rational

# ---------------------------------------------------------------------------
# p+4 rescue family
# P = m*p = 4*m*v-v-1.
# Hence 4/p = 4*m/P = 1/v + 1/P + 1/(P*v).
# ---------------------------------------------------------------------------
equal | 4*m*v*(4*m*v-v-1)*((4*m*v-v-1)*v) | (4*m*v-v-1)*(4*m*v-v-1)*((4*m*v-v-1)*v) + (4*m*v-v-1)*v*((4*m*v-v-1)*v) + (4*m*v-v-1)*v*(4*m*v-v-1) | m:rational v:rational

# Defining relation in the q=4m-1 form:
# (4m-1)v = P+1 where P=m*p.
equal | (4*m-1)*v | (4*m*v-v-1)+1 | m:rational v:rational

# ---------------------------------------------------------------------------
# General symmetric m-family
# P = m*p = 4*m*u*v-u-v.
# Hence 4/p = 4*m/P
#              = 1/(u*v) + 1/(P*u) + 1/(P*v).
# ---------------------------------------------------------------------------
equal | 4*m*(u*v)*((4*m*u*v-u-v)*u)*((4*m*u*v-u-v)*v) | (4*m*u*v-u-v)*((4*m*u*v-u-v)*u)*((4*m*u*v-u-v)*v) + (4*m*u*v-u-v)*(u*v)*((4*m*u*v-u-v)*v) + (4*m*u*v-u-v)*(u*v)*((4*m*u*v-u-v)*u) | m:rational u:rational v:rational

# Factorization:
# (4*m*u-1)(4*m*v-1)=4*m*P+1=4*m^2*p+1.
equal | (4*m*u-1)*(4*m*v-1) | 4*m*(4*m*u*v-u-v)+1 | m:rational u:rational v:rational

# ---------------------------------------------------------------------------
# Quadratic-shift c-family
# P = m*p = 4*c*m*d*v-d-v.
# Hence 4/p = 4*m/P
#   = 1/(c*d*v) + 1/(c*P*d) + 1/(c*P*v).
# ---------------------------------------------------------------------------
equal | 4*m*(c*d*v)*(c*(4*c*m*d*v-d-v)*d)*(c*(4*c*m*d*v-d-v)*v) | (4*c*m*d*v-d-v)*(c*(4*c*m*d*v-d-v)*d)*(c*(4*c*m*d*v-d-v)*v) + (4*c*m*d*v-d-v)*(c*d*v)*(c*(4*c*m*d*v-d-v)*v) + (4*c*m*d*v-d-v)*(c*d*v)*(c*(4*c*m*d*v-d-v)*d) | c:rational m:rational d:rational v:rational

# Factorization:
# (4*c*m*d-1)(4*c*m*v-1)=4*c*m*P+1=4*c*m^2*p+1.
equal | (4*c*m*d-1)*(4*c*m*v-1) | 4*c*m*(4*c*m*d*v-d-v)+1 | c:rational m:rational d:rational v:rational
