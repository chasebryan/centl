opam-version: "2.0"
synopsis: "A deterministic, exact-first mathematical evaluation kernel"
description: """
CENTL is a deterministic, exact-first mathematical evaluation kernel with a
calculator, a small expression language, and script, JSON, and MCP interfaces.
It keeps exact values exact, returns rigorous enclosures for explicit
approximation, and reports unsupported or indeterminate work honestly.
"""
maintainer: "chasebryan@users.noreply.github.com"
authors: "Chase Bryan"
license: "AGPL-3.0-or-later"
homepage: "https://github.com/chasebryan/centl"
bug-reports: "https://github.com/chasebryan/centl/issues"
dev-repo: "git+https://github.com/chasebryan/centl.git"
depends: [
  "ocaml" {= "4.14.1"}
  "dune" {= "3.24.1"}
  "zarith" {= "1.14"}
  "yojson" {= "2.2.2"}
  "conf-flint" {= "1"}
  "conf-gmp" {= "5"}
  "conf-mpfr" {= "3"}
  "alcotest" {with-test & = "1.9.1"}
  "qcheck" {with-test & = "0.91"}
  "ocamlformat" {= "0.29.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs "@install"]
]
run-test: ["dune" "runtest" "-p" name "-j" jobs]
