(library
 (name native_sanitizer_support)
 (modules native_sanitizer_support)
 (enabled_if
  (= %{env:CENTL_SANITIZERS=disabled} enabled))
 (foreign_stubs
  (language c)
  (names native_sanitizer_stubs)
  (include_dirs ../../src/native)
  (flags
   (:standard
    -Wall
    -Wextra
    -Werror
    -fsanitize=address,undefined
    -fno-omit-frame-pointer)))
 (c_library_flags
  -fsanitize=address,undefined
  -lflint
  -lmpfr
  -lgmp
  -lpthread
  -lm))

