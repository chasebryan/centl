#!/bin/sh
set -eu

if [ "${1:-}" = "What is 0.1 plus 0.2?" ]; then
  printf '3/10\n'
  exit 0
fi

if [ "${1:-}" = "--repl" ]; then
  printf 'CENTL-SCi v0.0.1-Camelus\n'
  printf 'Free for science.\n\n'
  printf '> '
  IFS= read -r command || true
  [ "${command:-}" = ":exit" ] || exit 2
  exit 0
fi

printf 'centl-sci fixture %s\n' "$*"
