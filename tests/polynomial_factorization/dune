(rule
 (target flint_factor_oracle)
 (deps flint_factor_oracle.c)
 (action
  (run cc -std=c11 -O2 -o %{target} %{dep:flint_factor_oracle.c} -lflint -lgmp)))

(rule
 (alias runtest)
 (deps
  test_polynomial_factorization_differential.py
  factorization_probe.exe
  flint_factor_oracle)
