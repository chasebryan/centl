#!/bin/sh
set -eu

fail() {
  printf 'raw REPL test: %s\n' "$1" >&2
  exit 1
}

binary=${1:-}
case_name=${2:-}
[ -x "$binary" ] || fail "calculator is not executable: $binary"
case "$binary" in
  *"'"*) fail "calculator path contains an unsupported single quote: $binary" ;;
esac
case "$case_name" in
  edit|limit|partial-escape) ;;
  *) fail "usage: raw-repl BINARY {edit|limit|partial-escape}" ;;
esac

# Keep a hard watchdog for genuine PTY hangs, but do not make preservation
# qualification depend on hosted-runner speed. The long-line cases below seed
# the real persistent-history store and recall the entry into the raw editor in
# one operation. This still exercises the production 32 KiB editor boundary,
# cursor editing, overflow state, terminal repainting, and REPL error path
# without forcing slow machines to echo tens of thousands of synthetic
# keystrokes one byte at a time.
watchdog_seconds=${CENTL_RAW_REPL_WATCHDOG_SECONDS:-120}
case "$watchdog_seconds" in
  ''|*[!0-9]*) fail "CENTL_RAW_REPL_WATCHDOG_SECONDS must be a positive integer" ;;
esac
[ "$watchdog_seconds" -gt 0 ] ||
  fail "CENTL_RAW_REPL_WATCHDOG_SECONDS must be a positive integer"

temporary=$(mktemp -d "${TMPDIR:-/tmp}/centl-raw-repl.XXXXXXXX")
input=$temporary/input
output=$temporary/output
history_root=$temporary/state
session_pid=""

cleanup() {
  exec 3>&- 2>/dev/null || :
  if [ -n "$session_pid" ] && kill -0 "$session_pid" 2>/dev/null; then
    kill "$session_pid" 2>/dev/null || :
    wait "$session_pid" 2>/dev/null || :
  fi
  rm -rf "$temporary"
}
trap cleanup EXIT HUP INT TERM

seed_history() {
  spaces=$1
  suffix=$2
  history_dir=$history_root/centl
  mkdir -p "$history_dir"
  {
    printf '{"version":1,"entries":["'
    awk -v count="$spaces" 'BEGIN { for (i = 0; i < count; i++) printf " " }'
    printf '%s' "$suffix"
    printf '"]}\n'
  } >"$history_dir/history.json"
  chmod 600 "$history_dir/history.json"
}

session_command="TERM=xterm; export TERM; exec '$binary' --color=never --no-history"
case "$case_name" in
  edit)
    # Exactly 30,000 bytes: 29,998 spaces followed by 12. Recalling the entry
    # performs one bounded editor copy; the cursor/delete operations then prove
    # editing remains correct near the production line-size ceiling.
    seed_history 29998 12
    session_command="TERM=xterm; XDG_STATE_HOME='$history_root'; export TERM XDG_STATE_HOME; exec '$binary' --color=never"
    ;;
  limit)
    # Exactly 32,768 bytes, which is the production history/editor boundary.
    # One additional printable byte must trip the raw editor overflow state and
    # produce CENTL's source-byte-limit error when the line is submitted.
    seed_history 32767 1
    session_command="TERM=xterm; XDG_STATE_HOME='$history_root'; export TERM XDG_STATE_HOME; exec '$binary' --color=never"
    ;;
esac

mkfifo "$input"
exec 3<>"$input"
timeout -k 5s "${watchdog_seconds}s" script -qefc "$session_command" /dev/null \
  <&3 3<&- >"$output" &
session_pid=$!

ready=0
while kill -0 "$session_pid" 2>/dev/null; do
  if grep -Fq 'centl> ' "$output" 2>/dev/null; then
    ready=1
    break
  fi
  sleep 0.05
done
[ "$ready" -eq 1 ] || fail "calculator exited before its prompt"

case "$case_name" in
  edit)
    # Recall the 30,000-byte line, move left over 2, delete 1, then submit 2.
    printf '\033[A\033[D\177\n:quit\n' >&3
    ;;
  limit)
    # Recall a full 32 KiB line, attempt one byte beyond the real editor limit,
    # submit it, then leave the fresh prompt after the required limit error.
    printf '\033[A1\n:quit\n' >&3
    ;;
  partial-escape)
    printf '\033' >&3
    sleep 0.1
    printf '\033[' >&3
    sleep 0.1
    printf ':quit\n' >&3
    ;;
esac
exec 3>&-

set +e
wait "$session_pid"
status=$?
set -e
session_pid=""
case "$status" in
  124|137)
    fail "PTY watchdog expired after ${watchdog_seconds}s while running $case_name"
    ;;
esac
[ "$status" -eq 0 ] || fail "calculator session exited with status $status"

case "$case_name" in
  edit)
    result=$(tr '\r' '\n' <"$output" | grep -x '2' | tail -n 1)
    [ "$result" = 2 ] || fail "edited expression did not evaluate to 2"
    printf '%s\n' "$result"
    ;;
  limit)
    result=$(
      tr '\r' '\n' <"$output" \
        | grep 'error: the expression exceeds the source-byte limit' \
        | tail -n 1
    )
    [ "$result" = 'error: the expression exceeds the source-byte limit' ] \
      || fail "source-byte limit was not reported"
    printf '%s\n' "$result"
    ;;
  partial-escape)
    printf '%s\n' raw-escape-ok
    ;;
esac
